// playground-nine — the editor IR + logical traversal.
//
// The first playground that isn't a CM6 demo. It models the Editor IR
// (editor-architecture.md §3) as a flat-indexed node tree and exercises
// the load-bearing editor mechanics:
//
//   - Logical traversal: step-into / step-out / step-over-sibling
//     (editor-architecture.md §2 — the IR's tree structure supports this
//     directly, no scope reconstruction from flat text).
//   - Cursor-driven fold state: toggle a node's collapse.
//   - Cursor-position-driven AUTO-COLLAPSE: as the cursor walks the tree,
//     everything not on the cursor's ancestor path collapses; ancestors
//     stay open. This is the locked "writing code IS debugging code"
//     philosophy — auto-collapse is cursor-position-driven, never
//     manually managed (editor-README design principle).
//
// Dogfood target: scrml's type system (enums + records) and reactive
// engine on a NON-TRIVIAL TREE — recursive tree-walk rendering, deep
// reactive array mutation, recursion in helpers. A different compiler
// surface from the CM6/LSP playgrounds.
//
// Controls (focus the tree pane first):
//   l / →   step into (first child)
//   h / ←   step out (parent)
//   j / ↓   next sibling
//   k / ↑   previous sibling
//   z / Spc toggle fold on cursor node
//   a       toggle auto-collapse mode
//
// Run: scrml dev src/playground-nine/app.scrml

<program>
${

type NodeKind:enum = { Program, Component, State, Func, Markup }

function kindGlyph(k: NodeKind) {
    return match k {
        .Program   :> "#"
        .Component :> "*"
        .State     :> "@"
        .Func      :> "f"
        .Markup    :> "<"
    }
}

function kindName(k: NodeKind) {
    return match k {
        .Program   :> "program"
        .Component :> "component"
        .State     :> "state"
        .Func      :> "function"
        .Markup    :> "markup"
    }
}

// Flat-indexed node arena. Each node: id, parent (-1 for root),
// kind, label, children (array of ids). This is the proven shape
// from playground-four, generalized to the editor IR.
@nodes = [
    { id: 0, parent: -1, kind: NodeKind.Program,   label: "program",                children: [1, 6] },
    { id: 1, parent: 0,  kind: NodeKind.Component,  label: "component Counter",       children: [2, 3] },
    { id: 2, parent: 1,  kind: NodeKind.State,      label: "count = 0",               children: [] },
    { id: 3, parent: 1,  kind: NodeKind.Func,       label: "increment()",             children: [4, 5] },
    { id: 4, parent: 3,  kind: NodeKind.State,      label: "count = count + 1",        children: [] },
    { id: 5, parent: 3,  kind: NodeKind.Markup,     label: "render badge",            children: [] },
    { id: 6, parent: 0,  kind: NodeKind.Component,  label: "component App",           children: [7, 8] },
    { id: 7, parent: 6,  kind: NodeKind.Markup,     label: "div.app",                 children: [9] },
    { id: 8, parent: 6,  kind: NodeKind.Func,       label: "mount()",                 children: [] },
    { id: 9, parent: 7,  kind: NodeKind.Markup,     label: "Counter instance",        children: [] }
]

@cursorId       = 0
@collapsed      = []
@autoCollapse   = true
@lastAction     = "ready — l/h step in/out, j/k siblings, z fold, a auto-collapse"

// --- node arena lookups -------------------------------------------

function idxOf(id) {
    for (let i = 0; i < @nodes.length; i = i + 1) {
        if (@nodes[i].id == id) { return i }
    }
    return -1
}

function childrenOf(id) {
    const ix = idxOf(id)
    if (ix < 0) { return [] }
    return @nodes[ix].children
}

function parentOf(id) {
    const ix = idxOf(id)
    if (ix < 0) { return -1 }
    return @nodes[ix].parent
}

function labelOf(id) {
    const ix = idxOf(id)
    if (ix < 0) { return "?" }
    return @nodes[ix].label
}

function manuallyCollapsed(id) {
    for (let i = 0; i < @collapsed.length; i = i + 1) {
        if (@collapsed[i] == id) { return true }
    }
    return false
}

// cur's ancestor chain includes maybeAncestor?
function isAncestorOf(maybeAncestor, id) {
    let cur = id
    let guard = 0
    while (cur >= 0 && guard < 100) {
        const p = parentOf(cur)
        if (p == maybeAncestor) { return true }
        cur = p
        guard = guard + 1
    }
    return false
}

// --- fold state: COMPUTED, not mutated ----------------------------
//
// Earlier this playground mutated a @collapsed array on every cursor
// move (via an applyAutoCollapse() + a `^{}` meta-effect). That set up
// a write-during-render ordering hazard: the render-effect reading
// @collapsed and the meta-effect writing @collapsed raced, and the
// tree froze after one update. Fix: fold state is now PURELY COMPUTED
// from @cursorId + @autoCollapse at render time. No mutation, no
// meta-effect — the cursor position alone drives folding. This is also
// a truer expression of the "auto-collapse is never manually managed"
// design principle.

function onCursorPath(id) {
    return (id == @cursorId) || isAncestorOf(id, @cursorId)
}

function isCollapsed(id) {
    const kids = childrenOf(id)
    if (kids.length == 0) { return false }
    if (@autoCollapse) {
        // auto: a node-with-children is open iff it's on the cursor path.
        return !onCursorPath(id)
    }
    // manual: only the explicitly-toggled set is collapsed.
    return manuallyCollapsed(id)
}

function toggleFold() {
    // Manual fold toggles the explicit set. Under auto-collapse it has
    // no visible effect (folding is computed) — flip auto off to use it.
    if (manuallyCollapsed(@cursorId)) {
        let next = []
        for (let i = 0; i < @collapsed.length; i = i + 1) {
            if (@collapsed[i] != @cursorId) { next = [...next, @collapsed[i]] }
        }
        @collapsed = next
        @lastAction = "expand " + labelOf(@cursorId)
    } else {
        @collapsed = [...@collapsed, @cursorId]
        @lastAction = "collapse " + labelOf(@cursorId)
    }
}

function toggleAutoCollapse() {
    @autoCollapse = !@autoCollapse
    @lastAction = @autoCollapse ? "auto-collapse ON" : "auto-collapse OFF (all expanded)"
}

// --- logical traversal --------------------------------------------

function stepInto() {
    const kids = childrenOf(@cursorId)
    if (kids.length > 0 && !isCollapsed(@cursorId)) {
        @cursorId = kids[0]
        @lastAction = "step into -> " + labelOf(@cursorId)
    } else {
        @lastAction = "step into: leaf or collapsed"
    }
}

function stepOut() {
    const p = parentOf(@cursorId)
    if (p >= 0) {
        @cursorId = p
        @lastAction = "step out -> " + labelOf(@cursorId)
    } else {
        @lastAction = "step out: at root"
    }
}

function siblingDelta(delta) {
    const p = parentOf(@cursorId)
    if (p < 0) {
        @lastAction = "siblings: root has none"
        return
    }
    const sibs = childrenOf(p)
    let found = -1
    for (let i = 0; i < sibs.length; i = i + 1) {
        if (sibs[i] == @cursorId) { found = i }
    }
    const target = found + delta
    if (found >= 0 && target >= 0 && target < sibs.length) {
        @cursorId = sibs[target]
        @lastAction = (delta > 0 ? "next" : "prev") + " sibling -> " + labelOf(@cursorId)
    } else {
        @lastAction = "siblings: no " + (delta > 0 ? "next" : "prev")
    }
}

// --- recursive tree-walk renderer ---------------------------------
//
// walk() calls itself for each visible child — this exercises scrml
// recursion. Collapsed nodes contribute their own line but not their
// subtree.

function indent(depth) {
    let s = ""
    for (let i = 0; i < depth; i = i + 1) { s = s + "  " }
    return s
}

function foldMark(id) {
    const kids = childrenOf(id)
    if (kids.length == 0) { return "" }
    if (isCollapsed(id)) { return " [+]" }
    return " [-]"
}

function walk(id, depth, acc) {
    const ix = idxOf(id)
    if (ix < 0) { return acc }
    const n = @nodes[ix]
    const isFolded = isCollapsed(id)
    const line = {
        id: n.id,
        depth: depth,
        prefix: indent(depth),
        glyph: kindGlyph(n.kind),
        label: n.label,
        mark: foldMark(n.id),
        isCursor: n.id == @cursorId
    }
    let out = [...acc, line]
    if (n.children.length > 0 && !isFolded) {
        for (let i = 0; i < n.children.length; i = i + 1) {
            out = walk(n.children[i], depth + 1, out)
        }
    }
    return out
}

function visibleLines() {
    return walk(0, 0, [])
}

// Bug V workaround: `class:cursor=ln.isCursor` on a for-lift element is
// evaluated at create-time only and never re-evaluates when @cursorId
// changes (filed). So instead of per-line class binding, render the
// whole tree as a SINGLE reactive ${...} string in a <pre> — a single
// text interpolation DOES re-render on every dep change. The cursor
// line gets a textual "> " marker.
function treeText() {
    const lines = walk(0, 0, [])
    let s = ""
    for (let i = 0; i < lines.length; i = i + 1) {
        const ln = lines[i]
        const cur = ln.isCursor ? "> " : "  "
        if (i > 0) { s = s + String.fromCharCode(10) }
        s = s + cur + ln.prefix + ln.glyph + " " + ln.label + ln.mark
    }
    return s
}

// --- keyboard router ----------------------------------------------

function handleKey(e) {
    const k = e.key
    if (k == "l" || k == "ArrowRight") { e.preventDefault(); stepInto(); return }
    if (k == "h" || k == "ArrowLeft")  { e.preventDefault(); stepOut(); return }
    if (k == "j" || k == "ArrowDown")  { e.preventDefault(); siblingDelta(1); return }
    if (k == "k" || k == "ArrowUp")    { e.preventDefault(); siblingDelta(-1); return }
    if (k == "z" || k == " ")          { e.preventDefault(); toggleFold(); return }
    if (k == "a")                      { e.preventDefault(); toggleAutoCollapse(); return }
    @lastAction = "ignored " + k
}

function countCollapsed() {
    let c = 0
    for (let i = 0; i < @nodes.length; i = i + 1) {
        if (isCollapsed(@nodes[i].id)) { c = c + 1 }
    }
    return c
}

// derived status pieces
const <cursorLabel> = labelOf(@cursorId)
const <collapsedCount> = countCollapsed()

}

<div class="app">
    <h1>playground-nine — editor IR + logical traversal</>
    <p class="subtitle">The Editor IR as a node tree. Logical traversal (step into/out/over) + cursor-driven auto-collapse — the "writing code IS debugging code" model.</>

    <div class="panel status">
        <div class="row"><span class="slabel">Cursor:</><span class="value">${@cursorLabel} (id ${@cursorId})</></>
        <div class="row"><span class="slabel">Auto-collapse:</><span class="value">${@autoCollapse ? "ON" : "OFF"}</></>
        <div class="row"><span class="slabel">Collapsed nodes:</><span class="value">${@collapsedCount}</></>
        <div class="row"><span class="slabel">Last action:</><span class="value">${@lastAction}</></>
    </>

    <div class="tree" tabindex="0" onkeydown=handleKey(event)>${treeText()}</>

    <div class="panel notes">
        <strong>Focus the tree, then:</> <code>l</code> or <code>→</code> step into · <code>h</code> or <code>←</code> step out · <code>j</code> <code>k</code> siblings · <code>z</code> or <code>Space</code> fold · <code>a</code> auto-collapse<br>
        With auto-collapse ON, walking the tree keeps only the cursor's ancestor path open — everything else folds away. That's the relevance principle applied to folding.
    </>
</>

#{
    body {
        margin: 0;
        background: #1a1a1a;
        color: #e0e0e0;
        font-family: ui-monospace, "SF Mono", Menlo, monospace;
    }
    .app { max-width: 820px; margin: 2rem auto; padding: 0 1.5rem; }
    h1 { color: #ffa500; margin: 0 0 0.25rem; font-size: 1.4rem; }
    .subtitle { color: #888; margin: 0 0 1.25rem; font-size: 0.85rem; }
    .panel {
        background: #222; border: 1px solid #333; border-radius: 6px;
        padding: 0.85rem 1rem; margin-bottom: 0.9rem;
    }
    .row { display: flex; gap: 0.75rem; align-items: flex-start; margin: 0.18rem 0; }
    .slabel { color: #888; font-size: 0.8rem; min-width: 9rem; }
    .value { color: #88ff88; font-weight: 600; word-break: break-all; }
    .tree {
        background: #111; border: 2px solid #333; border-radius: 6px;
        padding: 0.85rem 1rem; margin-bottom: 0.9rem;
        white-space: pre; font-size: 0.95rem; line-height: 1.5;
        min-height: 12rem; outline: none;
    }
    .tree:focus { border-color: #ffa500; }
    .line { color: #cfcfcf; padding: 0 0.3rem; border-radius: 3px; }
    .line.cursor { background: rgba(255, 165, 0, 0.22); color: #ffd479; font-weight: 700; }
    .notes { color: #aaa; font-size: 0.83rem; line-height: 1.7; }
    .notes strong { color: #ffa500; }
    .notes code {
        color: #88ff88; background: #111; padding: 1px 5px;
        border-radius: 3px; font-size: 0.78rem;
    }
}

</program>
