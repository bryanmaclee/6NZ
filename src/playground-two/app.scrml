// playground-two — it moves.
//
// Combines the classifier (playground-zero) and the mode machine
// (playground-one) with a real buffer + visible cursor + motions.
//
// Normal mode: hjkl move the cursor. i / a enter insert. v enters visual.
//              Esc always returns to normal. The cursor renders as a green
//              block on the current character.
// Insert mode: most keys type into the buffer. The FOUR motion-hold keys
//              (h / j / k / l) have special behavior — tapped alone they
//              still type their letter, but when you HOLD one and tap
//              another key, the roll triggers cursor motion in that hold's
//              direction. This is the z-motion payoff: navigation without
//              leaving insert mode.
// Visual mode: hjkl extends the cursor (selection rendering deferred).
//
// Run: scrml dev src/playground-two/app.scrml

<program>

${
    type Mode:enum = { Insert, Normal, Visual }

    function modeName(m: Mode) {
        return match m {
            .Insert :> "INSERT"
            .Normal :> "NORMAL"
            .Visual :> "VISUAL"
        }
    }

    function isMotionHold(ch) {
        return ch == "h" || ch == "j" || ch == "k" || ch == "l"
    }

    // Initial buffer assembled with String.fromCharCode(10) for newlines.
    // scrml string literals don't interpret \n as newline — they stay as
    // the 2-char sequence backslash+n. (Bug to file.)
    function buildInitialBuffer() {
        const nl = String.fromCharCode(10)
        return "Welcome to 6nz." + nl + nl +
            "Press i to enter INSERT mode and type." + nl +
            "Press Esc to return to NORMAL mode." + nl + nl +
            "In NORMAL: hjkl moves the cursor." + nl +
            "In INSERT: type normally, OR hold h j k l" + nl +
            "           + tap another key to nudge the cursor" + nl +
            "           in that direction. Thats z-motion:" + nl +
            "           navigation without leaving insert."
    }

    @mode: ModeMachine = Mode.Normal
    @buffer = buildInitialBuffer()
    @cursor = 0
    @_selAnchor = 0
    @pressed = []
    @lastEvent = "ready — hjkl to move, i for INSERT"

    // --- Pure motion helpers --------------------------------------

    // scrml string literals don't process \n escapes (filed as bug).
    // Using charCodeAt(p) != 10 (newline) avoids the issue.
    function lineStart(buf, pos) {
        let p = pos
        while (p > 0 && buf.charCodeAt(p - 1) != 10) { p = p - 1 }
        return p
    }

    function lineEnd(buf, pos) {
        let p = pos
        while (p < buf.length && buf.charCodeAt(p) != 10) { p = p + 1 }
        return p
    }

    function moveLeft(pos) {
        return pos > 0 ? pos - 1 : 0
    }

    function moveRight(pos, len) {
        return pos < len - 1 ? pos + 1 : (len > 0 ? len - 1 : 0)
    }

    // Workaround: scrml compiler drops the `return X + y` line when
    // preceded by `const y = a ? b : c` (ternary). Using Math.min +
    // explicit return avoids the pattern.
    function moveUp(buf, pos) {
        const col = pos - lineStart(buf, pos)
        const ls = lineStart(buf, pos)
        if (ls == 0) { return pos }
        const prevEnd = ls - 1
        const prevStart = lineStart(buf, prevEnd)
        const prevLen = prevEnd - prevStart
        const newCol = Math.min(col, prevLen)
        return prevStart + newCol
    }

    function moveDown(buf, pos) {
        const col = pos - lineStart(buf, pos)
        const le = lineEnd(buf, pos)
        if (le >= buf.length) { return pos }
        const nextStart = le + 1
        const nextEnd = lineEnd(buf, nextStart)
        const nextLen = nextEnd - nextStart
        const newCol = Math.min(col, nextLen)
        return nextStart + newCol
    }

    function applyMotionDir(dir) {
        if (dir == "left")       { @cursor = moveLeft(@cursor) }
        else if (dir == "right") { @cursor = moveRight(@cursor, @buffer.length) }
        else if (dir == "up")    { @cursor = moveUp(@buffer, @cursor) }
        else if (dir == "down")  { @cursor = moveDown(@buffer, @cursor) }
    }

    function dirForHold(holdKey) {
        if (holdKey == "h") { return "left" }
        if (holdKey == "l") { return "right" }
        if (holdKey == "j") { return "down" }
        if (holdKey == "k") { return "up" }
        return "none"
    }

    // --- Buffer edits ---------------------------------------------

    function insertCh(ch) {
        @buffer = @buffer.slice(0, @cursor) + ch + @buffer.slice(@cursor)
        @cursor = @cursor + 1
    }

    function doBackspace() {
        if (@cursor > 0) {
            @buffer = @buffer.slice(0, @cursor - 1) + @buffer.slice(@cursor)
            @cursor = @cursor - 1
        }
    }

    // --- Release-order classifier (from playground-zero) ----------

    function pressKey(key) {
        let already = false
        for (let i = 0; i < @pressed.length; i = i + 1) {
            if (@pressed[i].key == key) { already = true }
        }
        if (already) { return }
        @pressed = [...@pressed, { key: key, releasedDuringLifetime: 0 }]
    }

    function releaseKey(key) {
        let idx = -1
        for (let i = 0; i < @pressed.length; i = i + 1) {
            if (@pressed[i].key == key) { idx = i }
        }
        if (idx < 0) { return "UNKNOWN" }

        const entry = @pressed[idx]
        const hasEarlierStillDown = idx > 0

        const classification = hasEarlierStillDown
            ? "ROLL"
            : (entry.releasedDuringLifetime > 0 ? "HOLD" : "TAP")

        let next = []
        for (let i = 0; i < @pressed.length; i = i + 1) {
            if (i == idx) {
                // skip released
            } else if (i < idx) {
                next = [...next, { key: @pressed[i].key, releasedDuringLifetime: @pressed[i].releasedDuringLifetime + 1 }]
            } else {
                next = [...next, @pressed[i]]
            }
        }
        @pressed = next
        return classification
    }

    // --- Main keyboard handlers -----------------------------------

    function handleKeyDown(e) {
        e.preventDefault()

        // Esc always returns to normal from anywhere.
        if (e.key == "Escape") {
            if (@mode != Mode.Normal) {
                @mode = Mode.Normal
                @pressed = []
                @lastEvent = "-> NORMAL"
            }
            return
        }

        if (@mode == Mode.Normal) {
            const k = e.key
            if (k == "i") { @mode = Mode.Insert; @lastEvent = "-> INSERT"; return }
            if (k == "a") {
                @mode = Mode.Insert
                if (@cursor < @buffer.length - 1) { @cursor = @cursor + 1 }
                @lastEvent = "-> INSERT (after)"
                return
            }
            if (k == "v") {
                @mode = Mode.Visual
                @_selAnchor = @cursor
                @lastEvent = "-> VISUAL"
                return
            }
            if (k == "h") { applyMotionDir("left");  @lastEvent = "h (left)";  return }
            if (k == "l") { applyMotionDir("right"); @lastEvent = "l (right)"; return }
            if (k == "j") { applyMotionDir("down");  @lastEvent = "j (down)";  return }
            if (k == "k") { applyMotionDir("up");    @lastEvent = "k (up)";    return }
            @lastEvent = "normal: ignored " + k
            return
        }

        if (@mode == Mode.Insert) {
            const k = e.key

            if (k == "Backspace") { doBackspace(); @lastEvent = "backspace"; return }
            if (k == "Enter")     { insertCh(String.fromCharCode(10)); @lastEvent = "newline"; return }

            // Motion-holds are deferred to keyup so the classifier can
            // decide between "lonely tap (type it)" vs "hold with rolls
            // (motion)" vs "rolled under an earlier hold (also motion)".
            if (isMotionHold(k)) {
                pressKey(k)
                @lastEvent = "[" + k + "] pending..."
                return
            }

            // Any other printable key.
            if (k.length == 1) {
                // If a motion-hold is currently active, this key is a roll
                // under it → apply motion in the hold's direction instead
                // of typing. Bump the hold's releasedDuringLifetime counter
                // so its eventual keyup classifies as HOLD (not TAP), and
                // we don't end up typing the hold's letter.
                if (@pressed.length > 0) {
                    const outer = @pressed[0].key
                    const d = dirForHold(outer)
                    if (d != "none") {
                        applyMotionDir(d)
                        @pressed = @pressed.map(entry => {
                            return { key: entry.key, releasedDuringLifetime: entry.releasedDuringLifetime + 1 }
                        })
                        @lastEvent = "[" + outer + "](" + k + ") -> " + d
                        return
                    }
                }
                insertCh(k)
                @lastEvent = "typed '" + k + "'"
                return
            }
            return
        }

        if (@mode == Mode.Visual) {
            const k = e.key
            if (k == "v") { @mode = Mode.Normal; @lastEvent = "-> NORMAL"; return }
            if (k == "h") { applyMotionDir("left");  return }
            if (k == "l") { applyMotionDir("right"); return }
            if (k == "j") { applyMotionDir("down");  return }
            if (k == "k") { applyMotionDir("up");    return }
            return
        }
    }

    function handleKeyUp(e) {
        if (@mode != Mode.Insert) { return }
        const k = e.key
        if (!isMotionHold(k)) { return }

        const classification = releaseKey(k)

        if (classification == "TAP") {
            // Lonely tap of a motion-hold letter → type it.
            insertCh(k)
            @lastEvent = "tap: typed '" + k + "'"
        } else if (classification == "HOLD") {
            // Was a hold anchor; any rolls already fired motion on their keydown.
            // Cleanup only.
            @lastEvent = "[" + k + "] done"
        } else if (classification == "ROLL") {
            // Rolled under an earlier motion-hold. Apply that hold's direction.
            if (@pressed.length > 0) {
                const outer = @pressed[0].key
                const d = dirForHold(outer)
                applyMotionDir(d)
                @lastEvent = "[" + outer + "](" + k + ") -> " + d
            }
        }
    }

    function clearBuffer() {
        @mode = Mode.Normal
        @cursor = 0
        @pressed = []
        @lastEvent = "reset"
    }

    // Ternaries inside `const @name = ...` derived reactives appear to
    // compile to empty branches (scrml bug reported 2026-04-20). Helper
    // functions work around it.
    function glyphFor(ch) {
        if (ch.length > 0 && ch.charCodeAt(0) == 10) { return " " }
        if (ch == "") { return " " }
        return ch
    }

    function extraFor(ch) {
        if (ch.length > 0 && ch.charCodeAt(0) == 10) { return String.fromCharCode(10) }
        return ""
    }

    // --- Derived rendering pieces ---------------------------------

    const <isInsert>  = @mode == Mode.Insert
    const <isNormal>  = @mode == Mode.Normal
    const <isVisual>  = @mode == Mode.Visual
    // Note: the buffer/cursor/after segments are rendered inline in the
    // markup with ${...} expressions. Derived reactives (`const @x = ...`)
    // referenced from markup spans do not get their reactive display
    // wiring emitted by the current compiler — filed as a bug. Inline
    // expressions work fine.
}

<engine name=ModeMachine for=Mode initial=.Normal>
    .Insert => .Normal | .Visual
    .Normal => .Insert | .Visual
    .Visual => .Normal | .Insert
</>

<div class="app">
    <h1>playground-two — it moves</>
    <p class="subtitle">vim hjkl + z-motion rolls against a real buffer + visible cursor.</>

    <div class="mode-wrap">
        <span class="badge insert" if=@isInsert>INSERT</>
        <span class="badge normal" if=@isNormal>NORMAL</>
        <span class="badge visual" if=@isVisual>VISUAL</>
    </>

    <div
        class="buffer-pane"
        tabindex="0"
        onkeydown=${(e) => handleKeyDown(e)}
        onkeyup=${(e) => handleKeyUp(e)}
    >
        <span class="seg before">${@buffer.slice(0, @cursor)}</>
        <span class="seg cursor" class:insert-cursor=@isInsert class:block-cursor=@isNormal class:visual-cursor=@isVisual>${glyphFor(@buffer.slice(@cursor, @cursor + 1))}</>
        <span class="seg after">${extraFor(@buffer.slice(@cursor, @cursor + 1))}${@buffer.slice(@cursor + 1)}</>
    </>

    <div class="hint">${@lastEvent}</>

    <div class="panel notes">
        <strong>Focus the black pane first</>, then:<br>
        <strong>NORMAL:</> <code>h j k l</code> move · <code>i</code> insert · <code>a</code> insert after · <code>v</code> visual · <code>Esc</code> normal<br>
        <strong>INSERT:</> type normally · <code>Backspace</code> and <code>Enter</code> work · <strong>hold h j k or l + tap any key → cursor nudges in that direction</>
    </>

    <button class="reset-btn" onclick=clearBuffer()>Reset buffer</>
</>

#{
    body {
        margin: 0;
        background: #1a1a1a;
        color: #e0e0e0;
        font-family: ui-monospace, "SF Mono", Menlo, monospace;
    }

    .app {
        max-width: 820px;
        margin: 2rem auto;
        padding: 0 1.5rem;
    }

    h1 {
        color: #ffa500;
        margin: 0 0 0.25rem;
        font-size: 1.4rem;
    }

    .subtitle {
        color: #888;
        margin: 0 0 1.5rem;
        font-size: 0.85rem;
    }

    .mode-wrap {
        text-align: center;
        margin-bottom: 1rem;
        min-height: 2.8rem;
    }

    .badge {
        display: inline-block;
        padding: 0.5rem 1.5rem;
        font-size: 1.1rem;
        font-weight: 700;
        letter-spacing: 0.25em;
        border-radius: 6px;
        border: 2px solid currentColor;
    }

    .badge.insert { color: #ffa500; background: rgba(255, 165, 0, 0.1); }
    .badge.normal { color: #88ff88; background: rgba(136, 255, 136, 0.1); }
    .badge.visual { color: #ff66ff; background: rgba(255, 102, 255, 0.1); }

    .buffer-pane {
        background: #111;
        color: #e0e0e0;
        border: 2px solid #333;
        border-radius: 6px;
        padding: 1.1rem 1.2rem;
        font-family: inherit;
        font-size: 0.95rem;
        line-height: 1.55;
        min-height: 16rem;
        white-space: pre-wrap;
        outline: none;
        cursor: text;
    }

    .buffer-pane:focus {
        border-color: #ffa500;
    }

    .seg { white-space: pre-wrap; }

    .cursor {
        display: inline-block;
        min-width: 0.6em;
    }

    .cursor.block-cursor {
        background: #88ff88;
        color: #111;
    }

    .cursor.visual-cursor {
        background: #ff66ff;
        color: #111;
    }

    .cursor.insert-cursor {
        background: transparent;
        border-left: 2px solid #ffa500;
        margin-left: -1px;
        padding-right: 0;
    }

    .hint {
        margin-top: 0.8rem;
        color: #888;
        font-size: 0.85rem;
        min-height: 1.2em;
    }

    .notes {
        margin-top: 1.2rem;
        padding: 0.85rem 1rem;
        background: #222;
        border: 1px solid #333;
        border-radius: 6px;
        color: #aaa;
        font-size: 0.85rem;
        line-height: 1.7;
    }

    .notes strong { color: #ffa500; }
    .notes code {
        color: #88ff88;
        background: #111;
        padding: 1px 5px;
        border-radius: 3px;
        font-size: 0.8rem;
    }

    .reset-btn {
        margin-top: 1rem;
        background: #333;
        color: #e0e0e0;
        border: 1px solid #555;
        border-radius: 4px;
        padding: 0.4rem 0.9rem;
        cursor: pointer;
        font-family: inherit;
        font-size: 0.85rem;
    }

    .reset-btn:hover { background: #444; }
}

</program>
