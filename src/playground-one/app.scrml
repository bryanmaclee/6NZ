// playground-one — vim-style mode state machine, scrml-native.
//
// Models the modes 6nz will support: Insert (default), Normal (motions +
// operators), Visual (character-wise selection), VisualLine (line-wise
// selection), and ToggleHold (SPEC §10.3: hold a toggle key to fire
// normal-mode commands tap-repeatable, release to return to Insert).
//
// Uses scrml's <engine> primitive so the compiler enforces legal
// transitions. Any attempt to move Insert -> Visual without going
// through Normal would be rejected.
//
// Keybindings (basic vim subset, surface for the demo):
//   Esc            -> Normal (from anywhere)
//   i / a / o      -> Insert (from Normal, Visual, VisualLine)
//   v              -> Visual (toggle between Visual <-> Normal)
//   V              -> VisualLine (toggle between VisualLine <-> Normal)
//   Ctrl (hold)    -> ToggleHold (from Insert; release -> Insert)
//
// Run: scrml dev src/playground-one/app.scrml

<program>

${
    type Mode:enum = { Insert, Normal, Visual, VisualLine, ToggleHold }

    fn modeName(m: Mode) -> string {
        match m {
            .Insert :> "INSERT"
            .Normal :> "NORMAL"
            .Visual :> "VISUAL"
            .VisualLine :> "V-LINE"
            .ToggleHold :> "TOGGLE-HOLD"
        }
    }

    @mode: ModeMachine = Mode.Insert
    @lastKey = ""
    @lastTrigger = "(init)"
    @log = []

    function logLine(line) {
        @log = [line, ...@log].slice(0, 15)
    }

    function setMode(target: Mode, trigger: string) {
        const fromName = modeName(@mode)
        const toName = modeName(target)
        @mode = target
        @lastTrigger = trigger
        logLine(fromName + " -> " + toName + "  (" + trigger + ")")
    }

    function handleKeyDown(e) {
        @lastKey = e.key

        // Ctrl held from Insert = enter ToggleHold (SPEC §10.3 stand-in).
        if (e.key == "Control" && @mode == Mode.Insert) {
            setMode(Mode.ToggleHold, "Ctrl down")
            e.preventDefault()
            return
        }

        // Esc -> Normal from anywhere except Normal itself.
        if (e.key == "Escape") {
            if (@mode != Mode.Normal && @mode != Mode.ToggleHold) {
                setMode(Mode.Normal, "Esc")
                e.preventDefault()
            }
            return
        }

        // From Normal: vim-ish entries into other modes.
        if (@mode == Mode.Normal) {
            if (e.key == "i" || e.key == "a" || e.key == "o") {
                setMode(Mode.Insert, e.key)
                e.preventDefault()
            } else if (e.key == "v") {
                setMode(Mode.Visual, "v")
                e.preventDefault()
            } else if (e.key == "V") {
                setMode(Mode.VisualLine, "V")
                e.preventDefault()
            }
            return
        }

        // Visual toggles.
        if (@mode == Mode.Visual) {
            if (e.key == "v") {
                setMode(Mode.Normal, "v")
                e.preventDefault()
            } else if (e.key == "V") {
                setMode(Mode.VisualLine, "V")
                e.preventDefault()
            } else if (e.key == "Escape") {
                setMode(Mode.Normal, "Esc")
                e.preventDefault()
            }
            return
        }

        if (@mode == Mode.VisualLine) {
            if (e.key == "V") {
                setMode(Mode.Normal, "V")
                e.preventDefault()
            } else if (e.key == "v") {
                setMode(Mode.Visual, "v")
                e.preventDefault()
            } else if (e.key == "Escape") {
                setMode(Mode.Normal, "Esc")
                e.preventDefault()
            }
            return
        }
    }

    function handleKeyUp(e) {
        // Releasing Ctrl (or any key while in ToggleHold) returns to Insert.
        if (@mode == Mode.ToggleHold && e.key == "Control") {
            setMode(Mode.Insert, "Ctrl up")
        }
    }

    function clearMode() {
        @mode = Mode.Insert
        @lastKey = ""
        @lastTrigger = "(reset)"
        @log = []
    }

    const <isInsert>     = @mode == Mode.Insert
    const <isNormal>     = @mode == Mode.Normal
    const <isVisual>     = @mode == Mode.Visual
    const <isVisualLine> = @mode == Mode.VisualLine
    const <isToggleHold> = @mode == Mode.ToggleHold
}

<engine name=ModeMachine for=Mode initial=.Insert>
    .Insert     => .Normal | .ToggleHold
    .Normal     => .Insert | .Visual | .VisualLine
    .Visual     => .Normal | .VisualLine | .Insert
    .VisualLine => .Normal | .Visual | .Insert
    .ToggleHold => .Insert
</>

<div class="app">
    <h1>playground-one</>
    <p class="subtitle">vim-style mode state machine — scrml-native via &lt;machine&gt;.</>

    <div class="panel">
        <label>Input surface (click, then drive modes with Esc / i / a / o / v / V / Ctrl-hold):</>
        <textarea
            class="surface"
            onkeydown=${(e) => handleKeyDown(e)}
            onkeyup=${(e) => handleKeyUp(e)}
            placeholder="focus me first"
            rows="3"
        ></textarea>
    </>

    <div class="mode-display">
        <div class="badge insert"     if=@isInsert>INSERT</>
        <div class="badge normal"     if=@isNormal>NORMAL</>
        <div class="badge visual"     if=@isVisual>VISUAL</>
        <div class="badge visual"     if=@isVisualLine>V-LINE</>
        <div class="badge toggle"     if=@isToggleHold>TOGGLE-HOLD</>
    </>

    <div class="panel status">
        <div class="row">
            <span class="slabel">Last key:</>
            <span class="value">${@lastKey}</>
        </>
        <div class="row">
            <span class="slabel">Last trigger:</>
            <span class="value">${@lastTrigger}</>
        </>
    </>

    <div class="panel">
        <div class="row">
            <span class="slabel">Transition log:</>
            <button class="reset-btn" onclick=clearMode()>Clear</>
        </>
        <ol class="loglist">
            ${
                for (let line of @log) {
                    lift <li>${line}</>
                }
            }
        </ol>
    </>

    <div class="panel notes">
        <strong>Machine-enforced transitions.</> The compiler rejects any
        write to <code>@mode</code> that isn't a legal edge — e.g. Insert ->
        Visual direct is illegal; you must go through Normal.
    </>
</>

#{
    body {
        margin: 0;
        background: #1a1a1a;
        color: #e0e0e0;
        font-family: ui-monospace, "SF Mono", Menlo, monospace;
    }

    .app {
        max-width: 720px;
        margin: 2rem auto;
        padding: 0 1.5rem;
    }

    h1 {
        color: #ffa500;
        margin: 0 0 0.25rem;
        font-size: 1.4rem;
    }

    .subtitle {
        color: #888;
        margin: 0 0 1.5rem;
        font-size: 0.85rem;
    }

    .panel {
        background: #222;
        border: 1px solid #333;
        border-radius: 6px;
        padding: 0.9rem 1rem;
        margin-bottom: 1rem;
    }

    .panel label {
        display: block;
        color: #888;
        font-size: 0.8rem;
        margin-bottom: 0.4rem;
    }

    .surface {
        width: 100%;
        background: #111;
        color: #e0e0e0;
        border: 1px solid #444;
        border-radius: 4px;
        padding: 0.6rem;
        font-family: inherit;
        font-size: 0.95rem;
        box-sizing: border-box;
    }

    .surface:focus {
        outline: 2px solid #ffa500;
        outline-offset: -2px;
    }

    .mode-display {
        display: flex;
        justify-content: center;
        margin: 1.25rem 0;
        min-height: 4.5rem;
        align-items: center;
    }

    .badge {
        display: inline-block;
        padding: 0.85rem 2rem;
        font-size: 1.6rem;
        font-weight: 700;
        letter-spacing: 0.15em;
        border-radius: 8px;
        border: 2px solid currentColor;
    }

    .badge.insert  { color: #ffa500; background: rgba(255, 165, 0, 0.08); }
    .badge.normal  { color: #88ff88; background: rgba(136, 255, 136, 0.08); }
    .badge.visual  { color: #ff66ff; background: rgba(255, 102, 255, 0.08); }
    .badge.toggle  { color: #66ccff; background: rgba(102, 204, 255, 0.08); }

    .row {
        display: flex;
        gap: 0.75rem;
        align-items: center;
    }

    .status .row { margin: 0.25rem 0; }

    .slabel {
        color: #888;
        font-size: 0.8rem;
    }

    .value {
        color: #88ff88;
        font-weight: 600;
    }

    .reset-btn {
        margin-left: auto;
        background: #333;
        color: #e0e0e0;
        border: 1px solid #555;
        border-radius: 4px;
        padding: 0.25rem 0.7rem;
        cursor: pointer;
        font-family: inherit;
        font-size: 0.8rem;
    }

    .reset-btn:hover { background: #444; }

    .loglist {
        margin: 0.5rem 0 0;
        padding-left: 1.2rem;
        color: #ccc;
        font-size: 0.85rem;
        max-height: 12rem;
        overflow-y: auto;
    }

    .loglist li { padding: 0.1rem 0; }

    .notes {
        color: #aaa;
        font-size: 0.8rem;
        line-height: 1.5;
    }

    .notes strong { color: #e0e0e0; }
    .notes code { color: #ffa500; font-size: 0.85rem; }
}

</program>
