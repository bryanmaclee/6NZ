// playground-six — LSP diagnostics on a real CM6 surface.
//
// The wire:
//
//   browser <-- WebSocket --> bridge.js <-- stdio --> scrmlTS LSP
//
// scrml-side: CM6 mount, WebSocket client speaking JSON-RPC.
// bridge.js: spawns the LSP child and forwards Content-Length-framed
// messages in both directions.
//
// MVP scope: diagnostics only. Initialize, didOpen the CM6 buffer,
// didChange on every keystroke, render publishDiagnostics in a panel.
// Completions, go-to-def, hover, code actions all defer to a follow-up.
//
// Run:
//   1. Start the bridge:    bun src/playground-six/bridge.js
//   2. Compile + serve p6:  scrml dev src/playground-six/app.scrml
//
// (Ports default to 3061 for the LSP bridge, 3000 for scrml dev.)

<program>

${
    @cmStatus    = "loading CM6 from esm.sh..."
    @cmError     = ""
    @lspStatus   = "disconnected"
    @lspError    = ""
    @diagCount   = 0
    @diagnostics = []
    @cursorLine  = 1
    @cursorCol   = 1
    @docLength   = 0
    @lineCount   = 1
    @nextId      = 1

    // The scrml URI we report to the LSP for our buffer. The scheme
    // and exact path don't matter — what matters is that didOpen,
    // didChange, and publishDiagnostics all use the same URI.
    @docUri = "file:///playground-six.scrml"

    function nextId() {
        const id = @nextId
        @nextId = id + 1
        return id
    }

    function describeDiagnostic(d) {
        // d shape (LSP):
        //   range, severity (1=err 2=warn 3=info 4=hint), code, message
        const sev = d.severity == 1 ? "error" : (d.severity == 2 ? "warn" : "info")
        const ln  = d.range.start.line + 1
        const col = d.range.start.character + 1
        const code = d.code ? d.code + ": " : ""
        return sev + " (" + ln + "," + col + ") " + code + d.message
    }

    // Render the whole diagnostics list as a single string. We use this
    // instead of <li for=...> in the markup because the for-lift codegen
    // leaks the loop variable into the surrounding meta-effect closure
    // (filed as a separate codegen bug). Plain string interpolation
    // works around the issue.
    function describeDiagnostics(ds) {
        const nl = String.fromCharCode(10)
        let out = ""
        for (let i = 0; i < ds.length; i = i + 1) {
            out = out + describeDiagnostic(ds[i])
            if (i < ds.length - 1) { out = out + nl }
        }
        return out
    }

    function onLspMessage(jsonStr) {
        // Per Bug K fix: a throw inside a reactive effect won't propagate
        // out of the caller, so calling JSON.parse without try/catch is
        // safe — a malformed message just logs an error and skips this
        // dispatch. (scrml has no try/catch syntax; uses fail/failable.)
        const msg = JSON.parse(jsonStr)

        if (msg.method == "window/logMessage") {
            // Quietly absorb log messages — useful for debugging via
            // browser console but not part of the UI.
            console.log("[lsp]", msg.params.type, msg.params.message)
            return
        }

        if (msg.method == "textDocument/publishDiagnostics") {
            const ds = msg.params.diagnostics
            @diagnostics = ds
            @diagCount = ds.length
            return
        }

        if (msg.id == 1 && msg.result && msg.result.capabilities) {
            // initialize response — confirm capabilities, then send
            // initialized + open our doc.
            @lspStatus = "ready"
            const caps = msg.result.capabilities
            const has = []
            if (caps.completionProvider) { has.push("completion") }
            if (caps.hoverProvider) { has.push("hover") }
            if (caps.definitionProvider) { has.push("def") }
            if (caps.documentSymbolProvider) { has.push("symbols") }
            if (caps.signatureHelpProvider) { has.push("sig") }
            if (caps.codeActionProvider) { has.push("actions") }
            @cmStatus = "LSP ready: " + has.join(" / ")
            return
        }

        if (msg.error) {
            @lspError = "lsp error: " + (msg.error.message || JSON.stringify(msg.error))
        }
    }

    function lspSend(ws, msg) {
        ws.send(JSON.stringify(msg))
    }

    function sendInitialize(ws) {
        lspSend(ws, {
            jsonrpc: "2.0",
            id: nextId(),
            method: "initialize",
            params: {
                processId: not,
                rootUri: not,
                capabilities: {}
            }
        })
    }

    function sendInitialized(ws) {
        lspSend(ws, {
            jsonrpc: "2.0",
            method: "initialized",
            params: {}
        })
    }

    function sendDidOpen(ws, text) {
        lspSend(ws, {
            jsonrpc: "2.0",
            method: "textDocument/didOpen",
            params: {
                textDocument: {
                    uri: @docUri,
                    languageId: "scrml",
                    version: 1,
                    text: text
                }
            }
        })
    }

    function sendDidChange(ws, text, version) {
        lspSend(ws, {
            jsonrpc: "2.0",
            method: "textDocument/didChange",
            params: {
                textDocument: {
                    uri: @docUri,
                    version: version
                },
                contentChanges: [
                    { text: text }
                ]
            }
        })
    }

    @docVersion = 1

    // --- CM6 lifecycle -------------------------------------------

    function onDocUpdate(update) {
        if (update.docChanged || update.selectionSet) {
            const st = update.state
            @docLength = st.doc.length
            @lineCount = st.doc.lines
            const head = st.selection.main.head
            const line = st.doc.lineAt(head)
            @cursorLine = line.number
            @cursorCol  = head - line.from + 1
        }
        if (update.docChanged && window.__p6_ws && window.__p6_ws.readyState == 1) {
            @docVersion = @docVersion + 1
            sendDidChange(window.__p6_ws, update.state.doc.toString(), @docVersion)
        }
    }

    // Codegen bugs surfaced here (filing both):
    //   (1) obj.field = function() {...} mis-emits as two statements
    //       (member assignment with empty RHS + orphaned function).
    //       Workaround: addEventListener instead of property assignment.
    //   (2) Two consecutive @x = ... reactive writes INSIDE an inline
    //       function expression mis-emit (the first write loses its
    //       closing paren and the second emits as
    //       _scrml_reactive_get(...) = ...). Same pattern in named
    //       function bodies (p5's enterInsert etc) compiles fine —
    //       so the trigger is specifically inline-function-expression
    //       context. Workaround: extract each handler body to a
    //       named helper function and pass that by reference.

    function onWsOpen(ws) {
        @lspStatus = "init-sent"
        sendInitialize(ws)
    }

    function onWsMessage(ws, initialText, eventData) {
        const wasReady = @lspStatus == "ready"
        onLspMessage(eventData)
        const nowReady = @lspStatus == "ready"
        if (!wasReady && nowReady) {
            sendInitialized(ws)
            sendDidOpen(ws, initialText)
        }
    }

    function onWsError() {
        @lspStatus = "error"
        @lspError = "WebSocket error — is bridge.js running on :3061?"
    }

    function onWsClose() {
        if (@lspStatus != "error") { @lspStatus = "closed" }
    }

    function connectLsp(initialText) {
        @lspStatus = "connecting"
        const ws = new window.WebSocket("ws://localhost:3061")
        window.__p6_ws = ws

        // Inline function expressions wrap the helpers — these stay
        // shallow (single non-reactive call) so they avoid bug (2).
        ws.addEventListener("open",    function()  { onWsOpen(ws) })
        ws.addEventListener("message", function(e) { onWsMessage(ws, initialText, e.data) })
        ws.addEventListener("error",   function()  { onWsError() })
        ws.addEventListener("close",   function()  { onWsClose() })
    }

    function onCmReady(cm) {
        const host = document.querySelector(".cm-host")
        if (!host) {
            @cmStatus = "error: .cm-host not found"
            return
        }
        const nl = String.fromCharCode(10)
        // Note: raw { and } in concatenated string literals trip Bug L
        // (BS not string-aware in brace counting). Workaround: build the
        // braces from char codes so they live in their own variables,
        // then concatenate without exposing literal { or } to BS.
        const lb = String.fromCharCode(123)  // {
        const rb = String.fromCharCode(125)  // }
        const dol = String.fromCharCode(36)  // $
        // Clean sample doc — v0.3+ auto-lifts top-level decls; no ${...} wrap needed.
        const sampleDoc =
            "// playground-six — LSP diagnostics over WebSocket." + nl +
            "// Edit below; diagnostics appear in the panel beneath." + nl +
            nl +
            "<program>" + nl +
            nl +
            "@count = 0" + nl +
            "function bump() " + lb + " @count = @count + 1 " + rb + nl +
            nl +
            "<div>" + dol + lb + "@count" + rb + "</>" + nl +
            "<button onclick=bump()>+</>" + nl +
            nl +
            "</program>" + nl

        const listener = cm.EditorView.updateListener.of(onDocUpdate)
        const view = new cm.EditorView({
            parent: host,
            doc: sampleDoc,
            extensions: [cm.basicSetup, listener]
        })

        @docLength  = view.state.doc.length
        @lineCount  = view.state.doc.lines
        @cmStatus   = "CM6 mounted; connecting to LSP..."
        window.__cm = view

        connectLsp(sampleDoc)
    }

    function onCmError(e) {
        @cmStatus = "load failed"
        @cmError  = e.message ? e.message : String(e)
    }

    function loadCm() {
        // Bridge string assembled to keep brace pairs balanced WITHIN each
        // string literal (avoids Bug L). The big concatenated string has
        // {basicSetup} and {EditorView} as fully-balanced units inside their
        // respective import lines; the window.__cmMod = { ... } object
        // literal is also balanced within one string.
        const scriptText =
            "import {basicSetup} from 'https://esm.sh/codemirror@6.0.2'; " +
            "import {EditorView} from 'https://esm.sh/@codemirror/view@6'; " +
            "window.__cmMod = { basicSetup, EditorView }; " +
            "window.dispatchEvent(new CustomEvent('cm-loaded'));"
        const script = document.createElement("script")
        script.type = "module"
        script.textContent = scriptText
        script.onerror = onCmError
        window.addEventListener("cm-loaded", function() { onCmReady(window.__cmMod) }, { once: true })
        document.body.appendChild(script)
    }

    const @hasError = @lspError != "" || @cmError != ""
    const @hasDiagnostics = @diagCount > 0
    const @noDiagnostics = @diagCount == 0
}

^{ loadCm() }

<div class="app">
    <h1>playground-six — LSP diagnostics</>
    <p class="subtitle">CM6 buffer wired to scrmlTS LSP via WebSocket bridge. Type to see live diagnostics from the compiler pipeline.</>

    <div class="panel status">
        <div class="row">
            <span class="slabel">CM6:</>
            <span class="value">${@cmStatus}</>
        </>
        <div class="row">
            <span class="slabel">LSP:</>
            <span class="value">${@lspStatus}</>
        </>
        <div class="row">
            <span class="slabel">Cursor:</>
            <span class="value">line ${@cursorLine}, col ${@cursorCol}</>
        </>
        <div class="row">
            <span class="slabel">Doc:</>
            <span class="value">${@lineCount} lines, ${@docLength} chars</>
        </>
        <div class="row">
            <span class="slabel">Diagnostics:</>
            <span class="value">${@diagCount}</>
        </>
    </>

    <div class="panel err-panel" if=@hasError>
        <div if=(@cmError != "")><strong>CM6 error:</> ${@cmError}</>
        <div if=(@lspError != "")><strong>LSP error:</> ${@lspError}</>
    </>

    <div class="cm-host"></>

    <div class="panel diag-panel ok" if=@noDiagnostics>
        <strong>No diagnostics.</> The buffer is clean.
    </>

    <div class="panel diag-panel" if=@hasDiagnostics>
        <strong>Diagnostics (${@diagCount}):</>
        <pre class="diag-list">${describeDiagnostics(@diagnostics)}</pre>
    </>

    <div class="panel notes">
        <strong>Try editing.</> Add a syntax error (e.g. an unclosed tag, an unknown identifier in scrml) and watch the diagnostics panel populate.<br>
        <strong>Architecture:</> CM6 owns the doc; on every change, scrml sends <code>textDocument/didChange</code> over WebSocket; the bridge forwards to the LSP child via stdio; <code>textDocument/publishDiagnostics</code> notifications come back and update the panel.
    </>
</>

#{
    body {
        margin: 0;
        background: #1a1a1a;
        color: #e0e0e0;
        font-family: ui-monospace, "SF Mono", Menlo, monospace;
    }

    .app {
        max-width: 920px;
        margin: 2rem auto;
        padding: 0 1.5rem;
    }

    h1 {
        color: #ffa500;
        margin: 0 0 0.25rem;
        font-size: 1.4rem;
    }

    .subtitle {
        color: #888;
        margin: 0 0 1.25rem;
        font-size: 0.85rem;
    }

    .panel {
        background: #222;
        border: 1px solid #333;
        border-radius: 6px;
        padding: 0.85rem 1rem;
        margin-bottom: 0.9rem;
    }

    .row {
        display: flex;
        gap: 0.75rem;
        align-items: flex-start;
        margin: 0.18rem 0;
    }

    .slabel {
        color: #888;
        font-size: 0.8rem;
        min-width: 7rem;
    }

    .value {
        color: #88ff88;
        font-weight: 600;
        word-break: break-all;
    }

    .err-panel {
        border-color: #aa3333;
        background: #3a1a1a;
        color: #ffaaaa;
    }

    .cm-host {
        min-height: 16rem;
        background: #111;
        border: 2px solid #333;
        border-radius: 6px;
        margin-bottom: 0.9rem;
    }

    .cm-host:focus-within { border-color: #ffa500; }
    .cm-host .cm-editor {
        font-family: inherit;
        font-size: 0.92rem;
        min-height: 16rem;
    }

    .diag-panel.ok {
        border-color: #2a5a2a;
        background: #1a2a1a;
        color: #aaffaa;
    }

    .diag-list {
        margin: 0.5rem 0 0;
        padding-left: 1.2rem;
        list-style: square;
    }

    .diag-item {
        color: #ffaaaa;
        font-size: 0.85rem;
        line-height: 1.6;
        margin: 0.1rem 0;
        word-break: break-word;
    }

    .notes {
        color: #aaa;
        font-size: 0.83rem;
        line-height: 1.7;
    }

    .notes strong { color: #ffa500; }
    .notes code {
        color: #88ff88;
        background: #111;
        padding: 1px 5px;
        border-radius: 3px;
        font-size: 0.78rem;
    }
}

</program>
