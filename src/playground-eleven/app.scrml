// playground-eleven — flonav: keyboard orchestration nav + modal prompt.
//
// The first playground aimed at the FLOGENCE INTEGRATION (2026-07-06 plan
// amendment): before the standalone 6nz editor, the 6nz editing ideas land in
// flogence's cockpit. This prototype is the vehicle.
//
// It synthesizes two earlier playgrounds and reframes them for flogence's
// orchestration graph (floView: fleet -> project -> facet -> row):
//   - playground-nine: cursor-as-program-counter over a node tree — step
//     into/out/over siblings + cursor-driven AUTO-COLLAPSE (only the cursor's
//     ancestor path stays open). flogence's floView ALREADY has mouse-driven
//     drill + one-open-at-a-time collapse; this adds the keyboard cursor.
//   - playground-one: vim-style modal state machine via <engine>.
//
// The flogence-native modal framing (survey-derived):
//   NORMAL = keyboard cursor over the orchestration tree (hjkl)
//   INSERT = compose a prompt to the PA at the cursor node (Enter routes it)
//
// One keyboard surface owns the mode (no focus-juggling, no <input> — so it's
// clear of the verified scrml <each>-body handler/void/textarea defects
// filed 2026-07-06). The prompt buffer is synthesized reactively.
//
// Controls (focus the surface first):
//   NORMAL:  l/→ step into · h/← step out · j/↓ k/↑ siblings · a auto-collapse · i INSERT
//   INSERT:  type to compose · Enter route to cursor node · Esc back to NORMAL
//
// Run: scrml dev src/playground-eleven/app.scrml
<program>
${

type NodeKind:enum = { Fleet, Project, Facet, Row }
type Mode:enum = { Normal, Insert }

function kindGlyph(k: NodeKind) {
    return match k {
        .Fleet   :> "#"
        .Project :> ">"
        .Facet   :> "+"
        .Row     :> "-"
    }
}

// floView-shaped flat node arena (mirrors flogence's fleet -> project -> facet
// -> row spine). Same proven flat-index shape as playground-nine.
@nodes = [
    { id: 0,  parent: -1, kind: NodeKind.Fleet,   label: "fleet",                 children: [1, 10] },
    { id: 1,  parent: 0,  kind: NodeKind.Project, label: "scrml",                 children: [2, 4, 6, 8] },
    { id: 2,  parent: 1,  kind: NodeKind.Facet,   label: "satellite",             children: [3] },
    { id: 3,  parent: 2,  kind: NodeKind.Row,     label: "vPA heartbeat 2m ago",  children: [] },
    { id: 4,  parent: 1,  kind: NodeKind.Facet,   label: "vcs",                   children: [5] },
    { id: 5,  parent: 4,  kind: NodeKind.Row,     label: "ahead 3 clean",         children: [] },
    { id: 6,  parent: 1,  kind: NodeKind.Facet,   label: "deltas",                children: [7] },
    { id: 7,  parent: 6,  kind: NodeKind.Row,     label: "[204] land [205] find", children: [] },
    { id: 8,  parent: 1,  kind: NodeKind.Facet,   label: "tasks",                 children: [9] },
    { id: 9,  parent: 8,  kind: NodeKind.Row,     label: "3 open 1 running",      children: [] },
    { id: 10, parent: 0,  kind: NodeKind.Project, label: "6nz",                   children: [11, 13] },
    { id: 11, parent: 10, kind: NodeKind.Facet,   label: "satellite",             children: [12] },
    { id: 12, parent: 11, kind: NodeKind.Row,     label: "vPA not booted",        children: [] },
    { id: 13, parent: 10, kind: NodeKind.Facet,   label: "tasks",                 children: [14] },
    { id: 14, parent: 13, kind: NodeKind.Row,     label: "playground-eleven WIP", children: [] }
]

@mode: ModeMachine = Mode.Normal
@cursorId     = 0
@autoCollapse = true
@promptText   = ""
@routeLog     = []
@lastAction   = "NORMAL — l/h step, j/k siblings, i to message a PA"

// --- node arena lookups (mirror playground-nine) ------------------

function idxOf(id) {
    for (let i = 0; i < @nodes.length; i = i + 1) {
        if (@nodes[i].id == id) { return i }
    }
    return -1
}

function childrenOf(id) {
    const ix = idxOf(id)
    if (ix < 0) { return [] }
    return @nodes[ix].children
}

function parentOf(id) {
    const ix = idxOf(id)
    if (ix < 0) { return -1 }
    return @nodes[ix].parent
}

function labelOf(id) {
    const ix = idxOf(id)
    if (ix < 0) { return "?" }
    return @nodes[ix].label
}

function isAncestorOf(maybeAncestor, id) {
    let cur = id
    let guard = 0
    while (cur >= 0 && guard < 100) {
        const p = parentOf(cur)
        if (p == maybeAncestor) { return true }
        cur = p
        guard = guard + 1
    }
    return false
}

// --- fold state: COMPUTED from cursor path (no mutation — the pg-nine fix) --

function onCursorPath(id) {
    return (id == @cursorId) || isAncestorOf(id, @cursorId)
}

function isCollapsed(id) {
    const kids = childrenOf(id)
    if (kids.length == 0) { return false }
    if (@autoCollapse) {
        return !onCursorPath(id)
    }
    return false
}

function toggleAutoCollapse() {
    @autoCollapse = !@autoCollapse
    @lastAction = @autoCollapse ? "auto-collapse ON" : "auto-collapse OFF (all expanded)"
}

// --- logical traversal (mirror playground-nine) -------------------

function stepInto() {
    const kids = childrenOf(@cursorId)
    if (kids.length > 0 && !isCollapsed(@cursorId)) {
        @cursorId = kids[0]
        @lastAction = "step into -> " + labelOf(@cursorId)
    } else {
        @lastAction = "step into: leaf or collapsed"
    }
}

function stepOut() {
    const p = parentOf(@cursorId)
    if (p >= 0) {
        @cursorId = p
        @lastAction = "step out -> " + labelOf(@cursorId)
    } else {
        @lastAction = "step out: at fleet root"
    }
}

function siblingDelta(delta) {
    const p = parentOf(@cursorId)
    if (p < 0) {
        @lastAction = "siblings: fleet root has none"
        return
    }
    const sibs = childrenOf(p)
    let found = -1
    for (let i = 0; i < sibs.length; i = i + 1) {
        if (sibs[i] == @cursorId) { found = i }
    }
    const target = found + delta
    if (found >= 0 && target >= 0 && target < sibs.length) {
        @cursorId = sibs[target]
        @lastAction = (delta > 0 ? "next" : "prev") + " sibling -> " + labelOf(@cursorId)
    } else {
        @lastAction = "siblings: no " + (delta > 0 ? "next" : "prev")
    }
}

// --- modal keyboard router ----------------------------------------

function enterInsert() {
    @mode = Mode.Insert
    @lastAction = "INSERT — message " + labelOf(@cursorId)
}

function leaveInsert(reason) {
    @promptText = ""
    @mode = Mode.Normal
    @lastAction = reason
}

function routePrompt() {
    if (@promptText.length == 0) {
        @lastAction = "INSERT — empty, nothing routed"
        return
    }
    const entry = "-> " + labelOf(@cursorId) + ": " + @promptText
    @routeLog = [entry, ...@routeLog].slice(0, 8)
    @promptText = ""
    @mode = Mode.Normal
    @lastAction = "routed to " + labelOf(@cursorId)
}

function handleNormalKey(e) {
    const k = e.key
    if (k == "l" || k == "ArrowRight") { e.preventDefault(); stepInto(); return }
    if (k == "h" || k == "ArrowLeft")  { e.preventDefault(); stepOut(); return }
    if (k == "j" || k == "ArrowDown")  { e.preventDefault(); siblingDelta(1); return }
    if (k == "k" || k == "ArrowUp")    { e.preventDefault(); siblingDelta(-1); return }
    if (k == "a")                      { e.preventDefault(); toggleAutoCollapse(); return }
    if (k == "i")                      { e.preventDefault(); enterInsert(); return }
    @lastAction = "NORMAL: ignored " + k
}

function handleInsertKey(e) {
    const k = e.key
    if (k == "Escape")    { e.preventDefault(); leaveInsert("Esc — discarded"); return }
    if (k == "Enter")     { e.preventDefault(); routePrompt(); return }
    if (k == "Backspace") { e.preventDefault(); @promptText = @promptText.slice(0, -1); return }
    if (!e.ctrlKey && !e.metaKey && !e.altKey && k.length == 1) {
        e.preventDefault()
        @promptText = @promptText + k
    }
}

function handleKey(e) {
    if (@mode == Mode.Normal) { handleNormalKey(e) } else { handleInsertKey(e) }
}

// --- recursive tree-walk renderer (mirror playground-nine) --------

function indent(depth) {
    let s = ""
    for (let i = 0; i < depth; i = i + 1) { s = s + "  " }
    return s
}

function foldMark(id) {
    const kids = childrenOf(id)
    if (kids.length == 0) { return "" }
    if (isCollapsed(id)) { return " [+]" }
    return " [-]"
}

function walk(id, depth, acc) {
    const ix = idxOf(id)
    if (ix < 0) { return acc }
    const n = @nodes[ix]
    const isFolded = isCollapsed(id)
    const line = {
        id: n.id,
        prefix: indent(depth),
        glyph: kindGlyph(n.kind),
        label: n.label,
        mark: foldMark(n.id),
        isCursor: n.id == @cursorId
    }
    let out = [...acc, line]
    if (n.children.length > 0 && !isFolded) {
        for (let i = 0; i < n.children.length; i = i + 1) {
            out = walk(n.children[i], depth + 1, out)
        }
    }
    return out
}

// derived cells
const <cursorLabel> = labelOf(@cursorId)
const <visible> = walk(0, 0, [])
const <caret> = @mode == Mode.Insert ? "█" : ""

}

<engine name=ModeMachine for=Mode initial=.Normal>
    .Normal => .Insert
    .Insert => .Normal
</>

<div class="app">
    <h1>playground-eleven — flonav</>
    <p class="subtitle">Keyboard cursor over the orchestration graph (NORMAL) + modal PA prompt (INSERT). The 6nz editing model, reframed for flogence's floView.</>

    <div class="mode-display">
        <match for=Mode on=@mode>
            <Normal><div class="badge normal">NORMAL</></>
            <Insert><div class="badge insert">INSERT</></>
        </match>
    </>

    <div class="surface" tabindex="0" onkeydown=handleKey(event)>
        <div class="tree">
            <each in=@visible key=@.id>
                <div class="line" class:cursor=@.isCursor>${(@.isCursor ? "> " : "  ") + @.prefix + @.glyph + " " + @.label + @.mark}</div>
                <empty>(no nodes)</empty>
            </each>
        </>
        <div class="prompt-bar">
            <span class="prompt-target">${@cursorLabel} &lt;</>
            <span class="prompt-text">${@promptText + @caret}</>
        </>
    </>

    <div class="panel status">
        <div class="row"><span class="slabel">Cursor:</><span class="value">${@cursorLabel}</></>
        <div class="row"><span class="slabel">Auto-collapse:</><span class="value">${@autoCollapse ? "ON" : "OFF"}</></>
        <div class="row"><span class="slabel">Last action:</><span class="value">${@lastAction}</></>
    </>

    <div class="panel">
        <div class="row"><span class="slabel">Routed prompts:</></>
        <ol class="loglist">
            <each in=@routeLog key=__index__>
                <li : @.>
                <empty : "nothing routed yet — press i on a node, type, Enter">
            </each>
        </>
    </>

    <div class="panel notes">
        <strong>Focus the surface, then:</> <code>l</code> <code>h</code> step in/out · <code>j</code> <code>k</code> siblings · <code>a</code> auto-collapse · <code>i</code> INSERT<br/>
        In INSERT: type to compose, <code>Enter</code> routes the prompt to the PA at the cursor node, <code>Esc</code> back to NORMAL. One keyboard surface owns the mode — the flogence-native reframe of modal editing as orchestration navigation.
    </>
</>

#{
    body {
        margin: 0;
        background: #1a1a1a;
        color: #e0e0e0;
        font-family: ui-monospace, "SF Mono", Menlo, monospace;
    }
    .app { max-width: 820px; margin: 2rem auto; padding: 0 1.5rem; }
    h1 { color: #ffa500; margin: 0 0 0.25rem; font-size: 1.4rem; }
    .subtitle { color: #888; margin: 0 0 1.25rem; font-size: 0.85rem; }
    .mode-display { display: flex; justify-content: center; margin: 0.5rem 0 1rem; }
    .badge {
        display: inline-block; padding: 0.5rem 1.6rem; font-size: 1.2rem;
        font-weight: 700; letter-spacing: 0.15em; border-radius: 8px;
        border: 2px solid currentColor;
    }
    .badge.normal { color: #88ff88; background: rgba(136, 255, 136, 0.08); }
    .badge.insert { color: #ffa500; background: rgba(255, 165, 0, 0.08); }
    .surface {
        background: #111; border: 2px solid #333; border-radius: 6px;
        padding: 0.85rem 1rem; margin-bottom: 0.9rem; outline: none;
    }
    .surface:focus { border-color: #ffa500; }
    .tree { white-space: pre; font-size: 0.95rem; line-height: 1.5; min-height: 10rem; }
    .line { color: #cfcfcf; padding: 0 0.3rem; border-radius: 3px; }
    .line.cursor { background: rgba(255, 165, 0, 0.22); color: #ffd479; font-weight: 700; }
    .prompt-bar {
        margin-top: 0.75rem; padding-top: 0.6rem; border-top: 1px solid #333;
        display: flex; gap: 0.6rem; align-items: baseline; font-size: 0.95rem;
    }
    .prompt-target { color: #66ccff; font-weight: 600; }
    .prompt-text { color: #ffd479; white-space: pre; }
    .panel {
        background: #222; border: 1px solid #333; border-radius: 6px;
        padding: 0.85rem 1rem; margin-bottom: 0.9rem;
    }
    .row { display: flex; gap: 0.75rem; align-items: flex-start; margin: 0.18rem 0; }
    .slabel { color: #888; font-size: 0.8rem; min-width: 9rem; }
    .value { color: #88ff88; font-weight: 600; word-break: break-all; }
    .loglist { margin: 0.4rem 0 0; padding-left: 1.2rem; color: #ccc; font-size: 0.85rem; }
    .loglist li { padding: 0.1rem 0; }
    .notes { color: #aaa; font-size: 0.83rem; line-height: 1.7; }
    .notes strong { color: #ffa500; }
    .notes code { color: #88ff88; background: #111; padding: 1px 5px; border-radius: 3px; font-size: 0.78rem; }
}

</program>
