// playground-three — CodeMirror 6 probe.
//
// Question: can scrml consume CM6 cleanly? "No npm" was the concern.
// Approach: dynamic import() from esm.sh at mount time, mount CM6's
// EditorView on a div rendered by scrml, wire CM6 update events back
// into scrml reactive state.
//
// If this works, the locked 6nz architecture (CM6 + canvas overlay,
// PWA delivery) is viable. If it doesn't, we need to reconsider.
//
// Run: scrml dev src/playground-three/app.scrml

<program>

${
    @charCount = 0
    @lineCount = 0
    @docPreview = ""

    // CM6 load lifecycle as a typed enum cell (§13.5 RemoteData form), replacing
    // the prior @status string flag (loading/loaded/failed): Loading → Ready |
    // Failed. cmLabel projects the phase to the status string; @error carries the
    // failure detail. (Typed cell, not <engine> — no smoke gates this file, so the
    // lower-risk Tier-1 form per the S16 PA ruling.)
    type CmPhase:enum = { Loading, Ready, Failed }
    <cmPhase>: CmPhase = .Loading
    @error = ""

    function cmLabel(p: CmPhase) {
        return match p {
            .Loading :> "loading CM6 from esm.sh..."
            .Ready   :> "CM6 loaded and mounted"
            .Failed  :> "load failed"
        }
    }

    function onDocUpdate(update) {
        if (update.docChanged || update.viewportChanged) {
            @charCount = update.state.doc.length
            @lineCount = update.state.doc.lines
            @docPreview = update.state.doc.toString().slice(0, 100)
        }
    }

    function onCmReady(cm) {
        const host = document.querySelector(".cm-host")
        if (!host) {
            @cmPhase = .Failed
            @error = "error: .cm-host not found"
            return
        }
        const nl = String.fromCharCode(10)
        const sampleDoc =
            "// This editor IS CodeMirror 6." + nl +
            "// Mounted from a scrml ^{} block via dynamic import of esm.sh." + nl +
            "// Every keystroke updates the reactive counters above." + nl +
            nl +
            "const hello = 'world';" + nl +
            "console.log(hello);" + nl
        const listener = cm.EditorView.updateListener.of(onDocUpdate)
        const view = new cm.EditorView({
            parent: host,
            doc: sampleDoc,
            extensions: [cm.basicSetup, listener]
        })
        @charCount = view.state.doc.length
        @lineCount = view.state.doc.lines
        @docPreview = view.state.doc.toString().slice(0, 100)
        @cmPhase = .Ready
        window.__cm = view
    }

    function onCmError(e) {
        @cmPhase = .Failed
        @error = e.message ? e.message : String(e)
    }

    function loadCm() {
        // Inject a module script that imports CM6 from esm.sh and exposes
        // the loaded module on window.__cmMod, then dispatches a custom
        // event so scrml can pick it up. Dynamic `import()` isn't visible
        // to scrml's parser, so we do it via a type="module" script tag.
        //
        // CM6's `codemirror` meta-package only re-exports basicSetup;
        // EditorView lives in @codemirror/view. Each symbol has to be
        // named individually in the bridge. Also pinning @6.0.2 explicitly
        // — esm.sh resolves bare `@6` to a bogus 6.65.7 CM5 bundle.
        const scriptText =
            "import {basicSetup} from 'https://esm.sh/codemirror@6.0.2'; " +
            "import {EditorView} from 'https://esm.sh/@codemirror/view@6'; " +
            "window.__cmMod = { basicSetup, EditorView }; " +
            "window.dispatchEvent(new CustomEvent('cm-loaded'));"
        const script = document.createElement("script")
        script.type = "module"
        script.textContent = scriptText
        script.onerror = onCmError
        window.addEventListener("cm-loaded", function() { onCmReady(window.__cmMod) }, { once: true })
        document.body.appendChild(script)
    }
}

^{ loadCm() }

<div class="app">
    <h1>playground-three — CM6 probe</h1>
    <p class="subtitle">dynamically import CodeMirror 6 from esm.sh, mount it, and wire its state into scrml.</>

    <div class="panel status">
        <div class="row">
            <span class="slabel">CM6 status:</>
            <span class="value">${cmLabel(@cmPhase)}</>
        </>
        <div class="row">
            <span class="slabel">Characters:</>
            <span class="value">${@charCount}</>
        </>
        <div class="row">
            <span class="slabel">Lines:</>
            <span class="value">${@lineCount}</>
        </>
        <div class="row">
            <span class="slabel">Preview:</>
            <span class="value preview">${@docPreview}</>
        </>
    </>

    <div class="panel err-panel" if=(@error != "")>
        <strong>Error:</> ${@error}
    </>

    <div class="cm-host"></>

    <div class="panel notes">
        <strong>What a pass would prove:</><br>
        1. scrml can run arbitrary JS via ^{} at mount time.<br>
        2. A non-module client.js can still use dynamic import() to load a remote ES module.<br>
        3. CM6's EditorView mounts on a scrml-rendered div with no scrml-specific adaptation.<br>
        4. CM6 update listeners write into scrml reactives cleanly (state flows CM6 → scrml).
    </>
</>

#{
    body {
        margin: 0;
        background: #1a1a1a;
        color: #e0e0e0;
        font-family: ui-monospace, "SF Mono", Menlo, monospace;
    }

    .app {
        max-width: 860px;
        margin: 2rem auto;
        padding: 0 1.5rem;
    }

    h1 {
        color: #ffa500;
        margin: 0 0 0.25rem;
        font-size: 1.4rem;
    }

    .subtitle {
        color: #888;
        margin: 0 0 1.5rem;
        font-size: 0.85rem;
    }

    .panel {
        background: #222;
        border: 1px solid #333;
        border-radius: 6px;
        padding: 0.9rem 1rem;
        margin-bottom: 1rem;
    }

    .row {
        display: flex;
        gap: 0.75rem;
        align-items: flex-start;
        margin: 0.2rem 0;
    }

    .slabel {
        color: #888;
        font-size: 0.8rem;
        min-width: 8rem;
    }

    .value {
        color: #88ff88;
        font-weight: 600;
        word-break: break-all;
    }

    .preview {
        white-space: pre-wrap;
        font-size: 0.8rem;
        color: #ccc;
    }

    .err-panel {
        border-color: #aa3333;
        background: #3a1a1a;
        color: #ffaaaa;
    }

    .cm-host {
        min-height: 14rem;
        background: #111;
        border: 2px solid #333;
        border-radius: 6px;
    }

    .cm-host:focus-within { border-color: #ffa500; }

    /* CM6 injects its own styles but give it a sane default font */
    .cm-host .cm-editor {
        font-family: inherit;
        font-size: 0.9rem;
        min-height: 14rem;
    }

    .notes {
        color: #aaa;
        font-size: 0.85rem;
        line-height: 1.7;
    }

    .notes strong { color: #ffa500; }
}

</program>
