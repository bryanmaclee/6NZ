// playground-zero — first 6nz scrml experiment (workaround edition).
//
// Goal: prove the scrml stack can drive 6nz's input layer end-to-end.
// Implements the Z-motion release-order classifier (SPEC v0.4 §5).
//
// This file uses workarounds for four compiler bugs documented in
// ../../handOffs/hand-off.md (and reported to scrmlTS 2026-04-20):
//   Bug 1 — onkeydown/onkeyup attribute bindings drop the `event` arg
//           -> workaround: attach listeners directly in a ^{} block
//   Bug 2 — `let x = A; if (cond) x = B` emits shadow `const x = B`
//           -> workaround: compute the value as a single expression
//   Bug 3 — multi-statement arrow bodies inside `.map()` are dropped
//           -> workaround: use a for-loop that appends to a fresh array
//   Bug 4 — name-mangling bleeds onto DOM method calls when a user
//           function shares the name
//           -> workaround: avoid naming user functions after DOM methods
//
// The idiomatic version (what we'd LIKE to write) is in
// app.idiomatic-blocked.scrml alongside. When the bugs land, that
// file should compile and run identically to this one.
//
// Run: scrml dev src/playground-zero/app.scrml

<program>

${
    @pressed = []
    @lastEvent = "press keys to begin"
    @log = []

    function classifyKeyup(key) {
        let idx = -1
        for (let i = 0; i < @pressed.length; i = i + 1) {
            if (@pressed[i].key == key) { idx = i }
        }
        if (idx < 0) { return }

        const entry = @pressed[idx]
        const hasEarlierStillDown = idx > 0

        // Single-expression classification (Bug 2 workaround).
        const classification = hasEarlierStillDown
            ? "ROLL"
            : (entry.releasedDuringLifetime > 0 ? "HOLD" : "TAP")

        // For-loop array rebuild (Bug 3 workaround for .map + filter).
        let next = []
        for (let i = 0; i < @pressed.length; i = i + 1) {
            if (i == idx) {
                // skip released
            } else if (i < idx) {
                next = [...next, { key: @pressed[i].key, releasedDuringLifetime: @pressed[i].releasedDuringLifetime + 1 }]
            } else {
                next = [...next, @pressed[i]]
            }
        }
        @pressed = next

        @lastEvent = classification + "(" + key + ")"
        @log = [@lastEvent, ...@log].slice(0, 12)
    }

    function pressKey(key) {
        let already = false
        for (let i = 0; i < @pressed.length; i = i + 1) {
            if (@pressed[i].key == key) { already = true }
        }
        if (already) { return }
        @pressed = [...@pressed, { key: key, releasedDuringLifetime: 0 }]
    }

    function clearAll() {
        @pressed = []
        @lastEvent = "reset"
        @log = []
    }

    // Bug 1 workaround — attach keydown/keyup in a runtime ^{} block
    // rather than via onkeydown= / onkeyup= attribute bindings. This
    // also lets us call preventDefault() to keep the textarea from
    // actually consuming the keystrokes during classification.
    ^{
        const surface = document.querySelector(".surface")
        if (surface) {
            surface.addEventListener("keydown", (e) => {
                if (e.repeat) { return }
                pressKey(e.key)
                e.preventDefault()
            })
            surface.addEventListener("keyup", (e) => {
                classifyKeyup(e.key)
                e.preventDefault()
            })
        }
    }
}

<div class="app">
    <h1>playground-zero</>
    <p class="subtitle">Z-motion release-order classifier — first scrml-native 6nz experiment.</>

    <div class="panel">
        <label>Input surface (click to focus, then press keys):</>
        <textarea
            class="surface"
            placeholder="Click here, then roll your fingers across the home row."
            rows="4"
        ></textarea>
    </>

    <div class="panel status">
        <div class="row">
            <span class="slabel">Last classification:</>
            <span class="value">${@lastEvent}</>
        </>
        <div class="row">
            <span class="slabel">Currently down:</>
            <span class="value">${@pressed.map(e => e.key).join(" ")}</>
        </>
    </>

    <div class="panel">
        <div class="row">
            <span class="slabel">Event log:</>
            <button class="reset-btn" onclick=clearAll()>Clear</>
        </>
        <ol class="loglist">
            ${
                for (let line of @log) {
                    lift <li>${line}</>
                }
            }
        </ol>
    </>

    <div class="panel notes">
        <strong>Legend.</> TAP = no overlap. ROLL = released while earlier key still down.
        HOLD = earlier key was held, release(s) happened during its window.
    </>
</>

#{
    body {
        margin: 0;
        background: #1a1a1a;
        color: #e0e0e0;
        font-family: ui-monospace, "SF Mono", Menlo, monospace;
    }

    .app {
        max-width: 720px;
        margin: 2rem auto;
        padding: 0 1.5rem;
    }

    h1 {
        color: #ffa500;
        margin: 0 0 0.25rem;
        font-size: 1.4rem;
    }

    .subtitle {
        color: #888;
        margin: 0 0 1.5rem;
        font-size: 0.85rem;
    }

    .panel {
        background: #222;
        border: 1px solid #333;
        border-radius: 6px;
        padding: 0.9rem 1rem;
        margin-bottom: 1rem;
    }

    .panel label {
        display: block;
        color: #888;
        font-size: 0.8rem;
        margin-bottom: 0.4rem;
    }

    .surface {
        width: 100%;
        min-height: 5rem;
        background: #111;
        color: #e0e0e0;
        border: 1px solid #444;
        border-radius: 4px;
        padding: 0.6rem;
        font-family: inherit;
        font-size: 0.95rem;
        box-sizing: border-box;
        resize: vertical;
    }

    .surface:focus {
        outline: 2px solid #ffa500;
        outline-offset: -2px;
    }

    .status .row { margin: 0.25rem 0; }

    .row {
        display: flex;
        gap: 0.75rem;
        align-items: center;
    }

    .slabel {
        color: #888;
        font-size: 0.8rem;
    }

    .value {
        color: #88ff88;
        font-weight: 600;
    }

    .reset-btn {
        margin-left: auto;
        background: #333;
        color: #e0e0e0;
        border: 1px solid #555;
        border-radius: 4px;
        padding: 0.25rem 0.7rem;
        cursor: pointer;
        font-family: inherit;
        font-size: 0.8rem;
    }

    .reset-btn:hover { background: #444; }

    .loglist {
        margin: 0.5rem 0 0;
        padding-left: 1.2rem;
        color: #ccc;
        font-size: 0.85rem;
        max-height: 12rem;
        overflow-y: auto;
    }

    .loglist li { padding: 0.1rem 0; }

    .notes {
        color: #aaa;
        font-size: 0.8rem;
        line-height: 1.5;
    }

    .notes strong { color: #e0e0e0; }
}

</program>
