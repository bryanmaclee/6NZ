// playground-zero — first 6nz scrml experiment (working).
//
// Implements the Z-motion release-order classifier (SPEC v0.4 §5).
// Proves the scrml stack can drive 6nz's input layer end-to-end:
// keyboard event streams, reactive state, list rendering, scoped styles.
//
// Run: scrml dev src/playground-zero/app.scrml
//
// Classification rule (per SPEC v0.4 §5):
//   When key K goes UP:
//     - If an earlier-pressed key is STILL down  -> K is a ROLL
//     - Else if keys were released during K's lifetime -> K is a HOLD
//     - Else                                     -> K is a TAP

<program>

${
    // Currently-down keys, in the order they were pressed.
    // Each entry: { key: string, releasedDuringLifetime: number }
    @pressed = []

    // Last classification result (displayed prominently).
    @lastEvent = "press keys to begin"

    // Short history of recent classifications (newest first).
    @log = []

    function classifyKeyup(key) {
        const idx = @pressed.findIndex(e => e.key == key)
        if (idx < 0) { return }

        const entry = @pressed[idx]
        const hasEarlierStillDown = idx > 0

        let classification = "TAP"
        if (hasEarlierStillDown) {
            classification = "ROLL"
        } else if (entry.releasedDuringLifetime > 0) {
            classification = "HOLD"
        }

        // Every still-down earlier key gets its released-during-lifetime count bumped,
        // so when THAT key eventually releases it knows things happened during its window.
        const bumped = @pressed.map((e, i) => {
            if (i < idx) {
                return { key: e.key, releasedDuringLifetime: e.releasedDuringLifetime + 1 }
            }
            return e
        })

        // Remove the released key.
        @pressed = bumped.filter((_, i) => i != idx)

        @lastEvent = classification + "(" + key + ")"
        @log = [@lastEvent, ...@log].slice(0, 12)
    }

    function handleKeyDown(e) {
        // Ignore repeats (held key auto-firing keydown).
        if (e.repeat) { return }

        const already = @pressed.some(entry => entry.key == e.key)
        if (already) { return }

        @pressed = [...@pressed, { key: e.key, releasedDuringLifetime: 0 }]
    }

    function handleKeyUp(e) {
        classifyKeyup(e.key)
    }

    function clearLog() {
        @pressed = []
        @lastEvent = "reset"
        @log = []
    }
}

<div class="app">
    <h1>playground-zero</>
    <p class="subtitle">Z-motion release-order classifier — the first scrml-native 6nz experiment.</>

    <div class="panel">
        <label>Input surface (focus + press keys):</>
        <textarea
            class="surface"
            onkeydown=handleKeyDown()
            onkeyup=handleKeyUp()
            placeholder="Click here, then roll your fingers across the home row."
            rows="4"
        ></textarea>
    </>

    <div class="panel status">
        <div class="row">
            <span class="label">Last classification:</>
            <span class="value">${@lastEvent}</>
        </>
        <div class="row">
            <span class="label">Currently down:</>
            <span class="value">${@pressed.map(e => e.key).join(" ")}</>
        </>
    </>

    <div class="panel">
        <div class="row">
            <span class="label">Event log:</>
            <button class="reset-btn" onclick=clearLog()>Clear</>
        </>
        <ol class="log">
            ${
                for (let line of @log) {
                    lift <li>${line}</>
                }
            }
        </ol>
    </>

    <div class="panel notes">
        <strong>Legend.</> TAP = no overlap. ROLL = released while earlier key still down.
        HOLD = earlier key was held, release(s) happened during its window.
    </>
</>

#{
    body {
        margin: 0;
        background: #1a1a1a;
        color: #e0e0e0;
        font-family: ui-monospace, "SF Mono", Menlo, monospace;
    }

    .app {
        max-width: 720px;
        margin: 2rem auto;
        padding: 0 1.5rem;
    }

    h1 {
        color: #ffa500;
        margin: 0 0 0.25rem;
        font-size: 1.4rem;
    }

    .subtitle {
        color: #888;
        margin: 0 0 1.5rem;
        font-size: 0.85rem;
    }

    .panel {
        background: #222;
        border: 1px solid #333;
        border-radius: 6px;
        padding: 0.9rem 1rem;
        margin-bottom: 1rem;
    }

    .panel label {
        display: block;
        color: #888;
        font-size: 0.8rem;
        margin-bottom: 0.4rem;
    }

    .surface {
        width: 100%;
        min-height: 5rem;
        background: #111;
        color: #e0e0e0;
        border: 1px solid #444;
        border-radius: 4px;
        padding: 0.6rem;
        font-family: inherit;
        font-size: 0.95rem;
        box-sizing: border-box;
        resize: vertical;
    }

    .surface:focus {
        outline: 2px solid #ffa500;
        outline-offset: -2px;
    }

    .status .row { margin: 0.25rem 0; }

    .row {
        display: flex;
        gap: 0.75rem;
        align-items: center;
    }

    .label {
        color: #888;
        font-size: 0.8rem;
    }

    .value {
        color: #88ff88;
        font-weight: 600;
    }

    .reset-btn {
        margin-left: auto;
        background: #333;
        color: #e0e0e0;
        border: 1px solid #555;
        border-radius: 4px;
        padding: 0.25rem 0.7rem;
        cursor: pointer;
        font-family: inherit;
        font-size: 0.8rem;
    }

    .reset-btn:hover { background: #444; }

    .log {
        margin: 0.5rem 0 0;
        padding-left: 1.2rem;
        color: #ccc;
        font-size: 0.85rem;
        max-height: 12rem;
        overflow-y: auto;
    }

    .log li { padding: 0.1rem 0; }

    .notes {
        color: #aaa;
        font-size: 0.8rem;
        line-height: 1.5;
    }

    .notes strong { color: #e0e0e0; }
}

</program>
