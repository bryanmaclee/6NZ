// playground-five — vim modes on a real CM6 surface.
//
// The merge: playground-three's CM6 mount + playground-two's mode
// state machine + hjkl. CM6 is the buffer; scrml owns the mode and
// gates which keystrokes CM6 is allowed to act on.
//
// Architecture:
//   - CM6 owns the document, rendering, scrolling, undo/redo.
//   - scrml owns @mode (Insert / Normal / Visual) and intercepts
//     keystrokes on the host div in CAPTURE phase, so we run before
//     CM6's contenteditable handler.
//   - Normal: every keystroke is intercepted; recognized ones dispatch
//     CM6 selection updates; everything else is suppressed (no typing).
//   - Insert: only Esc is intercepted; CM6 handles the rest natively.
//   - Visual: like Normal but motions extend the selection (move head,
//     keep anchor).
//
// Cursor motion uses view.dispatch with a selection update payload
// of anchor and head. Up/down are line-aware via view.state.doc
// lineAt and line. All position reactives (line / col / length) come
// from CM6's updateListener and stay in sync with both scrml-driven
// motion and any CM6-internal motion (mouse, arrow keys in Insert).
//
// Run: scrml dev src/playground-five/app.scrml

<program>

${
    type Mode:enum = { Insert, Normal, Visual }

    function modeName(m: Mode) -> string {
        match m {
            .Insert :> "INSERT"
            .Normal :> "NORMAL"
            .Visual :> "VISUAL"
        }
    }

    @mode: ModeMachine = Mode.Normal
    @cursorLine = 1
    @cursorCol  = 1
    @docLength  = 0
    @lineCount  = 1
    @cmStatus   = "loading CM6 from esm.sh..."
    @cmError    = ""
    @lastEvent  = "ready — Esc/i/v switch modes; hjkl moves in Normal/Visual"

    // --- CM6 cursor motion helpers --------------------------------
    //
    // All take the EditorView and dispatch a selection update. anchor
    // and head can be the same (cursor) or different (selection). For
    // Normal mode we pass anchor == head; for Visual we keep anchor
    // fixed and move head.

    function setCursorTo(view, pos) {
        view.dispatch({ selection: { anchor: pos, head: pos } })
    }

    function setHeadTo(view, anchor, head) {
        view.dispatch({ selection: { anchor: anchor, head: head } })
    }

    function clampPos(pos, len) {
        if (pos < 0) { return 0 }
        if (pos > len) { return len }
        return pos
    }

    // Compute the line+col of a head position; return new head for an
    // up/down motion that preserves column-as-much-as-possible.
    function moveVerticalHead(view, head, delta) {
        const doc = view.state.doc
        const line = doc.lineAt(head)
        const targetLineNo = line.number + delta
        if (targetLineNo < 1 || targetLineNo > doc.lines) { return head }
        const col = head - line.from
        const targetLine = doc.line(targetLineNo)
        const newCol = Math.min(col, targetLine.length)
        return targetLine.from + newCol
    }

    function moveLeftHead(head)        { return head > 0 ? head - 1 : 0 }
    function moveRightHead(head, len)  { return head < len ? head + 1 : len }

    // --- Normal-mode actions --------------------------------------

    function nMoveLeft(view) {
        const head = view.state.selection.main.head
        setCursorTo(view, moveLeftHead(head))
    }

    function nMoveRight(view) {
        const head = view.state.selection.main.head
        setCursorTo(view, moveRightHead(head, view.state.doc.length))
    }

    function nMoveUp(view) {
        const head = view.state.selection.main.head
        setCursorTo(view, moveVerticalHead(view, head, -1))
    }

    function nMoveDown(view) {
        const head = view.state.selection.main.head
        setCursorTo(view, moveVerticalHead(view, head, 1))
    }

    function nGoLineStart(view) {
        const head = view.state.selection.main.head
        const line = view.state.doc.lineAt(head)
        setCursorTo(view, line.from)
    }

    function nGoLineEnd(view) {
        const head = view.state.selection.main.head
        const line = view.state.doc.lineAt(head)
        setCursorTo(view, line.to)
    }

    // --- Visual-mode actions (extend selection) -------------------

    function vMoveLeft(view) {
        const sel = view.state.selection.main
        setHeadTo(view, sel.anchor, moveLeftHead(sel.head))
    }

    function vMoveRight(view) {
        const sel = view.state.selection.main
        setHeadTo(view, sel.anchor, moveRightHead(sel.head, view.state.doc.length))
    }

    function vMoveUp(view) {
        const sel = view.state.selection.main
        setHeadTo(view, sel.anchor, moveVerticalHead(view, sel.head, -1))
    }

    function vMoveDown(view) {
        const sel = view.state.selection.main
        setHeadTo(view, sel.anchor, moveVerticalHead(view, sel.head, 1))
    }

    // --- Mode transitions -----------------------------------------

    function enterInsert() {
        @mode = Mode.Insert
        @lastEvent = "-> INSERT"
    }

    function enterNormal() {
        @mode = Mode.Normal
        @lastEvent = "-> NORMAL"
    }

    function enterVisual(view) {
        @mode = Mode.Visual
        // CM6's anchor is wherever the cursor is — the selection becomes
        // a 0-width selection that we then extend with hjkl.
        @lastEvent = "-> VISUAL"
    }

    // --- Master key router ----------------------------------------
    //
    // Called from a CAPTURE-phase listener on the .cm-host div, so it
    // runs before CM6's contenteditable handler. We preventDefault +
    // stopPropagation when we want to suppress CM6's default behavior.

    function routeKey(e, view) {
        // Esc always returns to Normal, from any mode.
        if (e.key == "Escape") {
            if (@mode != Mode.Normal) { enterNormal() }
            e.preventDefault()
            e.stopPropagation()
            return
        }

        if (@mode == Mode.Normal) {
            // Suppress ALL keys in Normal — only recognized commands act,
            // unrecognized keys are silently ignored (no typing).
            e.preventDefault()
            e.stopPropagation()
            const k = e.key
            if (k == "i") { enterInsert(); return }
            if (k == "a") {
                // Vim's a: insert AFTER cursor.
                const head = view.state.selection.main.head
                setCursorTo(view, moveRightHead(head, view.state.doc.length))
                enterInsert()
                @lastEvent = "-> INSERT (after)"
                return
            }
            if (k == "v") { enterVisual(view); return }
            if (k == "h") { nMoveLeft(view);   @lastEvent = "h"; return }
            if (k == "l") { nMoveRight(view);  @lastEvent = "l"; return }
            if (k == "j") { nMoveDown(view);   @lastEvent = "j"; return }
            if (k == "k") { nMoveUp(view);     @lastEvent = "k"; return }
            if (k == "0") { nGoLineStart(view); @lastEvent = "0"; return }
            if (k == "$") { nGoLineEnd(view);  @lastEvent = "$"; return }
            @lastEvent = "normal: ignored " + k
            return
        }

        if (@mode == Mode.Visual) {
            e.preventDefault()
            e.stopPropagation()
            const k = e.key
            if (k == "v") { enterNormal(); return }
            if (k == "i") { enterInsert(); return }
            if (k == "h") { vMoveLeft(view);  @lastEvent = "v: h"; return }
            if (k == "l") { vMoveRight(view); @lastEvent = "v: l"; return }
            if (k == "j") { vMoveDown(view);  @lastEvent = "v: j"; return }
            if (k == "k") { vMoveUp(view);    @lastEvent = "v: k"; return }
            @lastEvent = "visual: ignored " + k
            return
        }

        // Insert: let CM6 handle. We do NOT preventDefault.
    }

    // --- CM6 lifecycle (mostly carried over from playground-three) -

    function onDocUpdate(update) {
        if (update.docChanged || update.selectionSet || update.viewportChanged) {
            const st = update.state
            @docLength = st.doc.length
            @lineCount = st.doc.lines
            const head = st.selection.main.head
            const line = st.doc.lineAt(head)
            @cursorLine = line.number
            @cursorCol  = head - line.from + 1
        }
    }

    function onCmReady(cm) {
        const host = document.querySelector(".cm-host")
        if (!host) {
            @cmStatus = "error: .cm-host not found"
            return
        }
        const nl = String.fromCharCode(10)
        // Note: BS choked on unbalanced { or } inside string literals
        // (one string per brace, so they didn't pair up). Reproduced
        // with: "function greet(name) {" + nl + "}" — flagged for
        // filing. Workaround here: use String.fromCharCode(123/125)
        // when we want braces in the sample doc, OR just avoid them.
        // Using avoid for now; the doc is illustrative either way.
        const sampleDoc =
            "// playground-five — vim modes on CM6." + nl +
            "// Click here to focus, then press Esc for NORMAL." + nl +
            "// In NORMAL: hjkl moves; i/a enter INSERT; v enters VISUAL." + nl +
            "// In VISUAL: hjkl extends the selection; v or Esc returns to NORMAL." + nl +
            "// In INSERT: type normally. Esc returns to NORMAL." + nl +
            nl +
            "const greeting = 'hello, world!'" + nl +
            "console.log(greeting)" + nl +
            nl +
            "// Try moving across lines with j and k." + nl +
            "// Try v then hjkl to extend a selection." + nl

        const listener = cm.EditorView.updateListener.of(onDocUpdate)
        const view = new cm.EditorView({
            parent: host,
            doc: sampleDoc,
            extensions: [cm.basicSetup, listener]
        })

        // Capture-phase keydown listener fires BEFORE CM6's own handler.
        // mode-aware routing happens inside routeKey().
        host.addEventListener("keydown", function(e) { routeKey(e, view) }, true)

        // Initial reactive sync.
        @docLength  = view.state.doc.length
        @lineCount  = view.state.doc.lines
        const head  = view.state.selection.main.head
        const line  = view.state.doc.lineAt(head)
        @cursorLine = line.number
        @cursorCol  = head - line.from + 1
        @cmStatus   = "CM6 mounted; modal keymap active"

        window.__cm = view
        window.__p5_routeKey = routeKey
    }

    function onCmError(e) {
        @cmStatus = "load failed"
        @cmError  = e.message ? e.message : String(e)
    }

    function loadCm() {
        // Same bridge pattern as playground-three: dynamic import via
        // an injected module-script tag; bundle named exports onto
        // window.__cmMod; dispatch a CustomEvent so scrml can pick it up.
        const scriptText =
            "import {basicSetup} from 'https://esm.sh/codemirror@6.0.2'; " +
            "import {EditorView} from 'https://esm.sh/@codemirror/view@6'; " +
            "window.__cmMod = { basicSetup, EditorView }; " +
            "window.dispatchEvent(new CustomEvent('cm-loaded'));"
        const script = document.createElement("script")
        script.type = "module"
        script.textContent = scriptText
        script.onerror = onCmError
        window.addEventListener("cm-loaded", function() { onCmReady(window.__cmMod) }, { once: true })
        document.body.appendChild(script)
    }

}

<engine name=ModeMachine for=Mode initial=.Normal>
    .Insert => .Normal | .Visual
    .Normal => .Insert | .Visual
    .Visual => .Normal | .Insert
</>

^{ loadCm() }

<div class="app">
    <h1>playground-five — vim modes on CM6</>
    <p class="subtitle">CodeMirror 6 buffer + scrml-owned modal keymap (Insert / Normal / Visual). Capture-phase keydown gates CM6.</>

    <div class="mode-wrap">
        <match for=Mode on=@mode>
            <Insert><span class="badge insert">INSERT</></>
            <Normal><span class="badge normal">NORMAL</></>
            <Visual><span class="badge visual">VISUAL</></>
        </match>
    </>

    <div class="panel status">
        <div class="row">
            <span class="slabel">CM6 status:</>
            <span class="value">${@cmStatus}</>
        </>
        <div class="row">
            <span class="slabel">Cursor:</>
            <span class="value">line ${@cursorLine}, col ${@cursorCol}</>
        </>
        <div class="row">
            <span class="slabel">Doc:</>
            <span class="value">${@lineCount} lines, ${@docLength} chars</>
        </>
        <div class="row">
            <span class="slabel">Last event:</>
            <span class="value">${@lastEvent}</>
        </>
    </>

    <div class="panel err-panel" if=(@cmError != "")>
        <strong>Error:</> ${@cmError}
    </>

    <div class="cm-host"></>

    <div class="panel notes">
        <strong>Click the editor to focus, then:</><br>
        <strong>NORMAL:</> <code>h j k l</code> move · <code>0</code> line start · <code>$</code> line end · <code>i</code> insert · <code>a</code> insert after · <code>v</code> visual · <code>Esc</code> stay/return<br>
        <strong>INSERT:</> type normally · <code>Esc</code> -> NORMAL<br>
        <strong>VISUAL:</> <code>h j k l</code> extend · <code>v</code> or <code>Esc</code> -> NORMAL · <code>i</code> -> INSERT
    </>
</>

#{
    body {
        margin: 0;
        background: #1a1a1a;
        color: #e0e0e0;
        font-family: ui-monospace, "SF Mono", Menlo, monospace;
    }

    .app {
        max-width: 920px;
        margin: 2rem auto;
        padding: 0 1.5rem;
    }

    h1 {
        color: #ffa500;
        margin: 0 0 0.25rem;
        font-size: 1.4rem;
    }

    .subtitle {
        color: #888;
        margin: 0 0 1.25rem;
        font-size: 0.85rem;
    }

    .mode-wrap {
        text-align: center;
        margin-bottom: 1rem;
        min-height: 2.8rem;
    }

    .badge {
        display: inline-block;
        padding: 0.5rem 1.5rem;
        font-size: 1.05rem;
        font-weight: 700;
        letter-spacing: 0.25em;
        border-radius: 6px;
        border: 2px solid currentColor;
    }

    .badge.insert { color: #ffa500; background: rgba(255, 165, 0, 0.1); }
    .badge.normal { color: #88ff88; background: rgba(136, 255, 136, 0.1); }
    .badge.visual { color: #ff66ff; background: rgba(255, 102, 255, 0.1); }

    .panel {
        background: #222;
        border: 1px solid #333;
        border-radius: 6px;
        padding: 0.85rem 1rem;
        margin-bottom: 0.9rem;
    }

    .row {
        display: flex;
        gap: 0.75rem;
        align-items: flex-start;
        margin: 0.18rem 0;
    }

    .slabel {
        color: #888;
        font-size: 0.8rem;
        min-width: 8rem;
    }

    .value {
        color: #88ff88;
        font-weight: 600;
        word-break: break-all;
    }

    .err-panel {
        border-color: #aa3333;
        background: #3a1a1a;
        color: #ffaaaa;
    }

    .cm-host {
        min-height: 16rem;
        background: #111;
        border: 2px solid #333;
        border-radius: 6px;
        margin-bottom: 0.9rem;
    }

    .cm-host:focus-within { border-color: #ffa500; }

    .cm-host .cm-editor {
        font-family: inherit;
        font-size: 0.92rem;
        min-height: 16rem;
    }

    .notes {
        color: #aaa;
        font-size: 0.83rem;
        line-height: 1.7;
    }

    .notes strong { color: #ffa500; }
    .notes code {
        color: #88ff88;
        background: #111;
        padding: 1px 5px;
        border-radius: 3px;
        font-size: 0.78rem;
    }
}

</program>
