// playground-seven — z-motion on CM6.
//
// The graft: playground-two's release-order classifier into
// playground-five's vim-modes-on-CM6 keymap. In INSERT mode the four
// motion-hold letters (h / j / k / l) now defer to keyup so the
// classifier can decide:
//
//   - lonely TAP   → type the letter into CM6 (via view.dispatch)
//   - HOLD anchor  → cleanup only; any rolls already fired motion
//   - ROLL under   → apply motion in the outer hold's direction
//   - other-key + active motion-hold → motion (not typing)
//
// The payoff: navigate the buffer without leaving INSERT. NORMAL +
// VISUAL stay exactly like p5 — direct hjkl maps to motion / extend.
//
// Architecture inherits from p5:
//   - CM6 owns the document, rendering, scrolling, undo/redo.
//   - scrml owns @mode + the classifier state (@pressed).
//   - A CAPTURE-phase keydown listener on .cm-host runs before CM6's
//     contenteditable handler so we can preventDefault on h/j/k/l in
//     INSERT and on any roll-under key.
//   - A keyup listener (NOT capture) classifies releases and either
//     types a tapped letter or applies a rolled motion.
//
// Run: scrml dev src/playground-seven/app.scrml

<program>

// S123: bare `@x = init` at <program> body-top is now a compile error
// (E-WRITE-NOT-IN-LOGIC-CONTEXT). Default-logic auto-lifts declarations
// only; reactive-cell writes are logic and must be wrapped in ${...}.
// (This is the loud-error resolution of the Bug Q we filed S11.)
${

type Mode:enum = { Insert, Normal, Visual }

function modeName(m: Mode) -> string {
    match m {
        .Insert :> "INSERT"
        .Normal :> "NORMAL"
        .Visual :> "VISUAL"
    }
}

function isMotionHold(ch) {
    return ch == "h" || ch == "j" || ch == "k" || ch == "l"
}

function dirForHold(holdKey) {
    if (holdKey == "h") { return "left" }
    if (holdKey == "l") { return "right" }
    if (holdKey == "j") { return "down" }
    if (holdKey == "k") { return "up" }
    return "none"
}

@mode: ModeMachine = Mode.Normal
@cursorLine = 1
@cursorCol  = 1
@docLength  = 0
@lineCount  = 1
@cmStatus   = "loading CM6 from esm.sh..."
@cmError    = ""
@lastEvent  = "ready — Esc/i/v switch modes; in INSERT hold hjkl + tap roll → motion"
@pressed    = []

// --- CM6 cursor + buffer helpers ----------------------------------

function setCursorTo(view, pos) {
    view.dispatch({ selection: { anchor: pos, head: pos } })
}

function setHeadTo(view, anchor, head) {
    view.dispatch({ selection: { anchor: anchor, head: head } })
}

function insertAtCursor(view, ch) {
    const head = view.state.selection.main.head
    view.dispatch({
        changes: { from: head, to: head, insert: ch },
        selection: { anchor: head + ch.length, head: head + ch.length }
    })
}

function moveLeftHead(head)        { return head > 0 ? head - 1 : 0 }
function moveRightHead(head, len)  { return head < len ? head + 1 : len }

function moveVerticalHead(view, head, delta) {
    const doc = view.state.doc
    const line = doc.lineAt(head)
    const targetLineNo = line.number + delta
    if (targetLineNo < 1 || targetLineNo > doc.lines) { return head }
    const col = head - line.from
    const targetLine = doc.line(targetLineNo)
    const newCol = Math.min(col, targetLine.length)
    return targetLine.from + newCol
}

function applyMotionDir(view, dir) {
    const head = view.state.selection.main.head
    const len = view.state.doc.length
    if (dir == "left")  { setCursorTo(view, moveLeftHead(head)) }
    else if (dir == "right") { setCursorTo(view, moveRightHead(head, len)) }
    else if (dir == "up")    { setCursorTo(view, moveVerticalHead(view, head, -1)) }
    else if (dir == "down")  { setCursorTo(view, moveVerticalHead(view, head, 1)) }
}

function extendInDir(view, dir) {
    const sel = view.state.selection.main
    const len = view.state.doc.length
    if (dir == "left")  { setHeadTo(view, sel.anchor, moveLeftHead(sel.head)) }
    else if (dir == "right") { setHeadTo(view, sel.anchor, moveRightHead(sel.head, len)) }
    else if (dir == "up")    { setHeadTo(view, sel.anchor, moveVerticalHead(view, sel.head, -1)) }
    else if (dir == "down")  { setHeadTo(view, sel.anchor, moveVerticalHead(view, sel.head, 1)) }
}

// --- Mode transitions ---------------------------------------------

function enterInsert() {
    @mode = Mode.Insert
    @pressed = []
    @lastEvent = "-> INSERT"
}

function enterNormal() {
    @mode = Mode.Normal
    @pressed = []
    @lastEvent = "-> NORMAL"
}

function enterVisual(view) {
    @mode = Mode.Visual
    @pressed = []
    @lastEvent = "-> VISUAL"
}

// --- Release-order classifier (lifted from playground-two) --------

function pressKey(key) {
    let already = false
    for (let i = 0; i < @pressed.length; i = i + 1) {
        if (@pressed[i].key == key) { already = true }
    }
    if (already) { return }
    @pressed = [...@pressed, { key: key, releasedDuringLifetime: 0 }]
}

function releaseKey(key) {
    let idx = -1
    for (let i = 0; i < @pressed.length; i = i + 1) {
        if (@pressed[i].key == key) { idx = i }
    }
    if (idx < 0) { return "UNKNOWN" }

    const entry = @pressed[idx]
    const hasEarlierStillDown = idx > 0
    const classification = hasEarlierStillDown
        ? "ROLL"
        : (entry.releasedDuringLifetime > 0 ? "HOLD" : "TAP")

    let next = []
    for (let i = 0; i < @pressed.length; i = i + 1) {
        if (i == idx) {
            // skip released
        } else if (i < idx) {
            next = [...next, { key: @pressed[i].key, releasedDuringLifetime: @pressed[i].releasedDuringLifetime + 1 }]
        } else {
            next = [...next, @pressed[i]]
        }
    }
    @pressed = next
    return classification
}

// Bump releasedDuringLifetime on every currently-held hold when
// ANY other key gets released (counts the intervening release).
function bumpAllHolds() {
    @pressed = @pressed.map(entry => {
        return { key: entry.key, releasedDuringLifetime: entry.releasedDuringLifetime + 1 }
    })
}

// --- Master key router (CAPTURE-phase keydown) --------------------

function routeKey(e, view) {
    // Esc always returns to Normal, from any mode.
    if (e.key == "Escape") {
        if (@mode != Mode.Normal) { enterNormal() }
        e.preventDefault()
        e.stopPropagation()
        return
    }

    if (@mode == Mode.Normal) {
        e.preventDefault()
        e.stopPropagation()
        const k = e.key
        if (k == "i") { enterInsert(); return }
        if (k == "a") {
            const head = view.state.selection.main.head
            setCursorTo(view, moveRightHead(head, view.state.doc.length))
            enterInsert()
            @lastEvent = "-> INSERT (after)"
            return
        }
        if (k == "v") { enterVisual(view); return }
        if (k == "h") { applyMotionDir(view, "left");  @lastEvent = "h"; return }
        if (k == "l") { applyMotionDir(view, "right"); @lastEvent = "l"; return }
        if (k == "j") { applyMotionDir(view, "down");  @lastEvent = "j"; return }
        if (k == "k") { applyMotionDir(view, "up");    @lastEvent = "k"; return }
        if (k == "0") {
            const head = view.state.selection.main.head
            const line = view.state.doc.lineAt(head)
            setCursorTo(view, line.from)
            @lastEvent = "0"
            return
        }
        if (k == "$") {
            const head = view.state.selection.main.head
            const line = view.state.doc.lineAt(head)
            setCursorTo(view, line.to)
            @lastEvent = "$"
            return
        }
        @lastEvent = "normal: ignored " + k
        return
    }

    if (@mode == Mode.Visual) {
        e.preventDefault()
        e.stopPropagation()
        const k = e.key
        if (k == "v") { enterNormal(); return }
        if (k == "i") { enterInsert(); return }
        if (k == "h") { extendInDir(view, "left");  @lastEvent = "v: h"; return }
        if (k == "l") { extendInDir(view, "right"); @lastEvent = "v: l"; return }
        if (k == "j") { extendInDir(view, "down");  @lastEvent = "v: j"; return }
        if (k == "k") { extendInDir(view, "up");    @lastEvent = "v: k"; return }
        @lastEvent = "visual: ignored " + k
        return
    }

    // INSERT — the z-motion arena.
    const k = e.key

    // Motion-hold letters: defer to keyup so the classifier can decide.
    if (isMotionHold(k)) {
        // Defer typing decision until classified at keyup.
        e.preventDefault()
        e.stopPropagation()
        pressKey(k)
        @lastEvent = "[" + k + "] pending..."
        return
    }

    // Any other printable key while a motion-hold is active → roll
    // under it. Apply motion in the outer hold's direction, do NOT
    // type the rolled key, and bump the hold so its eventual keyup
    // classifies as HOLD (not TAP).
    if (@pressed.length > 0 && k.length == 1) {
        const outer = @pressed[0].key
        const d = dirForHold(outer)
        if (d != "none") {
            applyMotionDir(view, d)
            @pressed = @pressed.map(entry => {
                return { key: entry.key, releasedDuringLifetime: entry.releasedDuringLifetime + 1 }
            })
            e.preventDefault()
            e.stopPropagation()
            @lastEvent = "[" + outer + "](" + k + ") -> " + d
            return
        }
    }

    // No active hold + ordinary key → let CM6 type it natively.
    @lastEvent = "type: " + k
}

// --- Keyup handler (NOT capture-phase) ----------------------------

function routeKeyUp(e, view) {
    if (@mode != Mode.Insert) { return }
    const k = e.key

    if (!isMotionHold(k)) {
        // Non-hold key release while a hold is active counts as an
        // intervening release for the hold's classification.
        if (@pressed.length > 0) { bumpAllHolds() }
        return
    }

    const classification = releaseKey(k)

    if (classification == "TAP") {
        // Lonely tap of a motion-hold letter → type it via CM6.
        insertAtCursor(view, k)
        @lastEvent = "tap: typed '" + k + "'"
    } else if (classification == "HOLD") {
        @lastEvent = "[" + k + "] done"
    } else if (classification == "ROLL") {
        if (@pressed.length > 0) {
            const outer = @pressed[0].key
            const d = dirForHold(outer)
            applyMotionDir(view, d)
            @lastEvent = "[" + outer + "](" + k + ") -> " + d
        }
    }
}

// --- CM6 lifecycle ------------------------------------------------

function onDocUpdate(update) {
    if (update.docChanged || update.selectionSet || update.viewportChanged) {
        const st = update.state
        @docLength = st.doc.length
        @lineCount = st.doc.lines
        const head = st.selection.main.head
        const line = st.doc.lineAt(head)
        @cursorLine = line.number
        @cursorCol  = head - line.from + 1
    }
}

function onCmReady(cm) {
    const host = document.querySelector(".cm-host")
    if (!host) {
        @cmStatus = "error: .cm-host not found"
        return
    }
    const nl = String.fromCharCode(10)
    // Bug L workaround: BS's brace counter is not string-aware
    // (filed 2026-04-25, fix reverted; awaiting native-parser M6).
    // Keep braces out of string literals in this file.
    const sampleDoc =
        "// playground-seven — z-motion on CM6." + nl +
        "// Click here, then press Esc for NORMAL." + nl +
        "// In INSERT: type normally, OR hold h/j/k/l + tap any key" + nl +
        "//            -> cursor nudges in that direction. No mode switch." + nl +
        nl +
        "const greeting = 'hello, z-motion'" + nl +
        "console.log(greeting)" + nl +
        nl +
        "// Try it: enter INSERT (i), then hold j and tap any key." + nl +
        "// You'll move DOWN without leaving INSERT or typing the rolled key." + nl

    const listener = cm.EditorView.updateListener.of(onDocUpdate)
    const view = new cm.EditorView({
        parent: host,
        doc: sampleDoc,
        extensions: [cm.basicSetup, listener]
    })

    // CAPTURE-phase keydown fires BEFORE CM6's contenteditable handler.
    host.addEventListener("keydown", function(e) { routeKey(e, view) }, true)
    // Keyup classifies releases; bubble-phase is fine.
    host.addEventListener("keyup",   function(e) { routeKeyUp(e, view) }, false)

    @docLength  = view.state.doc.length
    @lineCount  = view.state.doc.lines
    const head  = view.state.selection.main.head
    const line  = view.state.doc.lineAt(head)
    @cursorLine = line.number
    @cursorCol  = head - line.from + 1
    @cmStatus   = "CM6 mounted; z-motion keymap active"

    window.__cm = view
    window.__p7_routeKey = routeKey
    window.__p7_routeKeyUp = routeKeyUp
}

function onCmError(e) {
    @cmStatus = "load failed"
    @cmError  = e.message ? e.message : String(e)
}

function loadCm() {
    const scriptText =
        "import {basicSetup} from 'https://esm.sh/codemirror@6.0.2'; " +
        "import {EditorView} from 'https://esm.sh/@codemirror/view@6'; " +
        "window.__cmMod = { basicSetup, EditorView }; " +
        "window.dispatchEvent(new CustomEvent('cm-loaded'));"
    const script = document.createElement("script")
    script.type = "module"
    script.textContent = scriptText
    script.onerror = onCmError
    window.addEventListener("cm-loaded", function() { onCmReady(window.__cmMod) }, { once: true })
    document.body.appendChild(script)
}

}

<engine name=ModeMachine for=Mode initial=.Normal>
    .Insert => .Normal | .Visual
    .Normal => .Insert | .Visual
    .Visual => .Normal | .Insert
</>

^{ loadCm() }

<div class="app">
    <h1>playground-seven — z-motion on CM6</>
    <p class="subtitle">CodeMirror 6 + scrml modal keymap + release-order classifier. Hold hjkl + tap a roll → motion without leaving INSERT.</>

    <div class="mode-wrap">
        <match for=Mode on=@mode>
            <Insert><span class="badge insert">INSERT</></>
            <Normal><span class="badge normal">NORMAL</></>
            <Visual><span class="badge visual">VISUAL</></>
        </match>
    </>

    <div class="panel status">
        <div class="row">
            <span class="slabel">CM6 status:</>
            <span class="value">${@cmStatus}</>
        </>
        <div class="row">
            <span class="slabel">Cursor:</>
            <span class="value">line ${@cursorLine}, col ${@cursorCol}</>
        </>
        <div class="row">
            <span class="slabel">Doc:</>
            <span class="value">${@lineCount} lines, ${@docLength} chars</>
        </>
        <div class="row">
            <span class="slabel">Pressed (classifier):</>
            <span class="value">${@pressed.length} held</>
        </>
        <div class="row">
            <span class="slabel">Last event:</>
            <span class="value">${@lastEvent}</>
        </>
    </>

    <div class="panel err-panel" if=(@cmError != "")>
        <strong>Error:</> ${@cmError}
    </>

    <div class="cm-host"></>

    <div class="panel notes">
        <strong>Click the editor to focus, then:</><br>
        <strong>NORMAL:</> <code>h j k l</code> move · <code>0</code> line start · <code>$</code> line end · <code>i</code> insert · <code>a</code> insert after · <code>v</code> visual · <code>Esc</code> stay/return<br>
        <strong>INSERT:</> type normally · <strong>hold <code>h j k l</code> + tap any key → cursor nudges that way</> · <code>Esc</code> -> NORMAL<br>
        <strong>VISUAL:</> <code>h j k l</code> extend · <code>v</code> or <code>Esc</code> -> NORMAL · <code>i</code> -> INSERT
    </>
</>

#{
    body {
        margin: 0;
        background: #1a1a1a;
        color: #e0e0e0;
        font-family: ui-monospace, "SF Mono", Menlo, monospace;
    }

    .app {
        max-width: 920px;
        margin: 2rem auto;
        padding: 0 1.5rem;
    }

    h1 {
        color: #ffa500;
        margin: 0 0 0.25rem;
        font-size: 1.4rem;
    }

    .subtitle {
        color: #888;
        margin: 0 0 1.25rem;
        font-size: 0.85rem;
    }

    .mode-wrap {
        text-align: center;
        margin-bottom: 1rem;
        min-height: 2.8rem;
    }

    .badge {
        display: inline-block;
        padding: 0.5rem 1.5rem;
        font-size: 1.05rem;
        font-weight: 700;
        letter-spacing: 0.25em;
        border-radius: 6px;
        border: 2px solid currentColor;
    }

    .badge.insert { color: #ffa500; background: rgba(255, 165, 0, 0.1); }
    .badge.normal { color: #88ff88; background: rgba(136, 255, 136, 0.1); }
    .badge.visual { color: #ff66ff; background: rgba(255, 102, 255, 0.1); }

    .panel {
        background: #222;
        border: 1px solid #333;
        border-radius: 6px;
        padding: 0.85rem 1rem;
        margin-bottom: 0.9rem;
    }

    .row {
        display: flex;
        gap: 0.75rem;
        align-items: flex-start;
        margin: 0.18rem 0;
    }

    .slabel {
        color: #888;
        font-size: 0.8rem;
        min-width: 11rem;
    }

    .value {
        color: #88ff88;
        font-weight: 600;
        word-break: break-all;
    }

    .err-panel {
        border-color: #aa3333;
        background: #3a1a1a;
        color: #ffaaaa;
    }

    .cm-host {
        min-height: 16rem;
        background: #111;
        border: 2px solid #333;
        border-radius: 6px;
        margin-bottom: 0.9rem;
    }

    .cm-host:focus-within { border-color: #ffa500; }

    .cm-host .cm-editor {
        font-family: inherit;
        font-size: 0.92rem;
        min-height: 16rem;
    }

    .notes {
        color: #aaa;
        font-size: 0.83rem;
        line-height: 1.7;
    }

    .notes strong { color: #ffa500; }
    .notes code {
        color: #88ff88;
        background: #111;
        padding: 1px 5px;
        border-radius: 3px;
        font-size: 0.78rem;
    }
}

</program>
